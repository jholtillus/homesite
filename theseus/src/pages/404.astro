---
import T from '../layouts/T.astro';
---
<T title="Not found">
  <section class="band dark" style="min-height:60vh">
    <div class="wrap">
      <p class="eyebrow">404</p>
      <h1 style="font-size:clamp(2.6rem,6vw,4.6rem);margin:14px 0 20px;color:var(--gold)">Lost in the labyrinth.</h1>
      <p class="lede">Even Theseus needed a thread. This page doesn’t exist.</p>
      <div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:28px"><a href="/" class="btn flame">Back to Theseus</a><a href="/read/" class="btn">Read online</a></div>
    </div>
  </section>
</T>
