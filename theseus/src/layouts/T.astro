---
import '../styles/theseus.css';
import { MAIN_URL, links } from '../data/theseus';
interface Props { title?: string; description?: string; image?: string; reader?: boolean }
const { title, description = 'I’ve taken the narrative of his life directly from the ancient writings of Plutarch and spun it into a colorful, fully-illustrated, coming-of-age adventure both sincere and humorous.', image = '/images/hero-theseus.jpg', reader = false } = Astro.props;
const full = title ? `${title} — Theseus` : 'Theseus — Jordan Holt';
const path = Astro.url.pathname;
const nav = [
  { label: 'The Story', href: '/#story' },
  { label: 'The Books', href: '/#books' },
  { label: 'Pages', href: '/#pages' },
  { label: 'Read', href: '/read/' },
  { label: 'The Creator', href: '/#creator' },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{full}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={new URL(path, Astro.site)} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={full} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL(image, Astro.site)} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@jholtillus" />
</head>
<body class:list={{ reader }}>
  <a href="#main" class="sr-only">Skip to content</a>
  <header class="hdr" data-hdr>
    <div class="wrap bar">
      <a href="/" class="mark" aria-label="Theseus, home"><img src="/images/logo.png" alt="Theseus" width="800" height="192" /></a>
      <nav class="desk" aria-label="Theseus">
        {nav.map((n) => <a href={n.href} class:list={{ on: n.href === path }}>{n.label}</a>)}
      </nav>
      <div class="tools">
        <a href="/#buy" class="btn flame sm">Get the books</a>
        <button class="burger" data-menu-toggle aria-label="Open menu" aria-expanded="false" aria-controls="t-menu"><span></span><span></span></button>
      </div>
    </div>
    <div class="mmenu" id="t-menu" data-menu hidden>
      <nav class="wrap" aria-label="Theseus menu">
        {nav.map((n) => <a href={n.href}>{n.label}</a>)}
        <a href="/#buy">Get the books</a>
        <a href={MAIN_URL} class="home">Jordan Holt ↗</a>
      </nav>
    </div>
  </header>
  <main id="main"><slot /></main>
  {!reader && (
    <footer class="ftr dark">
      <div class="wrap cols">
        <div>
          <a href="/" class="mark big meander"><img src="/images/logo.png" alt="Theseus" width="800" height="192" loading="lazy" /></a>

        </div>
        <div>
          <p class="eyebrow">Read</p>
          <ul><li><a href="/read/">Read online</a></li><li><a href={links.webtoon} target="_blank" rel="noopener">Webtoon ↗</a></li><li><a href="/#buy">Buy the books</a></li></ul>
        </div>
        <div>
          <p class="eyebrow">Follow</p>
          <ul><li><a href={links.substack} target="_blank" rel="noopener">Newsletter ↗</a></li><li><a href={links.youtube} target="_blank" rel="noopener">YouTube ↗</a></li><li><a href={links.x} target="_blank" rel="noopener">X ↗</a></li><li><a href={links.instagram} target="_blank" rel="noopener">Instagram ↗</a></li></ul>
        </div>
        <div>
          <p class="eyebrow">Jordan Holt</p>
          <ul><li><a href={MAIN_URL}>Portfolio ↗</a></li><li><a href={`${MAIN_URL}/projects/`}>Other projects ↗</a></li><li><a href={`${MAIN_URL}/shop/`}>Shop ↗</a></li><li><a href={`${MAIN_URL}/contact/`}>Commissions ↗</a></li></ul>
        </div>
      </div>
      <div class="wrap legal"><span>© {new Date().getFullYear()} Jordan Holt. All artwork © Jordan Holt.</span><span>I don’t use AI in any form.</span></div>
    </footer>
  )}
  <script>
    const hdr = document.querySelector('[data-hdr]')!;
    const onScroll = () => hdr.classList.toggle('scrolled', scrollY > 6);
    addEventListener('scroll', onScroll, { passive: true }); onScroll();
    const t = document.querySelector<HTMLButtonElement>('[data-menu-toggle]')!, m = document.querySelector<HTMLElement>('[data-menu]')!;
    const set = (o: boolean) => { t.setAttribute('aria-expanded', String(o)); t.setAttribute('aria-label', o ? 'Close menu' : 'Open menu'); m.hidden = !o; document.body.style.overflow = o ? 'hidden' : ''; };
    t.addEventListener('click', () => set(t.getAttribute('aria-expanded') !== 'true'));
    m.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) set(false); });
  </script>
</body>
</html>
<style>
  body::before { content: ''; position: fixed; inset: 0 0 auto; height: env(safe-area-inset-top, 0px); background: var(--night); z-index: 70; }
  .hdr { position: sticky; top: env(safe-area-inset-top, 0px); z-index: 60; background: rgba(33, 30, 51, .92); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border-bottom: 1px solid transparent; transition: border-color .3s; }
  .hdr.scrolled { border-color: var(--line); }
  :global(body.reader) .hdr { background: rgba(24, 22, 42, .94); }
  .bar { height: var(--header); display: flex; align-items: center; justify-content: space-between; gap: 20px; }
  .mark img { height: 30px; width: auto; }
  .mark.big { display: inline-block; padding: 18px 28px; margin-left: -28px; }
  .mark.big img { height: 56px; }
  .desk { display: flex; gap: clamp(16px, 2.2vw, 32px); }
  .desk a { font: 400 12.5px/1 var(--sans); letter-spacing: .1em; text-transform: uppercase; padding: 6px 0; border-bottom: 1px solid transparent; transition: border-color .2s; }
  .desk a:hover, .desk a.on { border-color: var(--flame); }
  .tools { display: flex; align-items: center; gap: 18px; }
  .btn.sm { min-height: 38px; padding: 0 16px; font-size: 11px; }
  .burger { display: none; width: 26px; height: 26px; position: relative; }
  .burger span { position: absolute; left: 1px; right: 1px; height: 1.5px; background: var(--on-night); transition: transform .3s var(--ease), top .3s var(--ease); }
  .burger span:first-child { top: 9px; } .burger span:last-child { top: 16px; }
  .burger[aria-expanded='true'] span:first-child { top: 12.5px; transform: rotate(45deg); }
  .burger[aria-expanded='true'] span:last-child { top: 12.5px; transform: rotate(-45deg); }
  .mmenu { position: fixed; inset: calc(var(--header) + env(safe-area-inset-top, 0px)) 0 0 0; background: var(--night); overflow-y: auto; }
  .mmenu nav { display: flex; flex-direction: column; padding-top: 16px; padding-bottom: 48px; }
  .mmenu a { font: 400 2rem/1.2 var(--serif); padding: 12px 0; border-bottom: 1px solid var(--line); }
  .mmenu a.home { font: 400 13px/1 var(--sans); letter-spacing: .08em; text-transform: uppercase; color: var(--sky); border: 0; padding-top: 28px; }
  .ftr { padding: 72px 0 calc(28px + env(safe-area-inset-bottom, 0px)); }
  .cols { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 40px; }
  .cols p.muted { max-width: 38ch; font-size: 15px; }
  .ftr ul { list-style: none; padding: 0; margin: 16px 0 0; display: grid; gap: 10px; font-size: 15px; }
  .ftr ul a:hover { color: var(--flame); }
  .legal { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 10px; margin-top: 56px; padding-top: 22px; border-top: 1px solid rgba(255,255,255,.12); font-size: 12px; color: var(--on-night-muted); }
  @media (max-width: 960px) { .desk { display: none; } .burger { display: block; } .cols { grid-template-columns: 1fr 1fr; } .cols > :first-child { grid-column: 1 / -1; } }
  @media (max-width: 420px) { .tools .btn { display: none; } }
</style>
