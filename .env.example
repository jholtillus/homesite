# Public site URL
SITE_URL=https://jordanholt.art

# Shopify Storefront API (Shopify admin > Apps > Develop apps > Storefront API access token)
# Public token: safe to expose in the browser. Leave blank to use cart permalinks instead.
PUBLIC_SHOPIFY_DOMAIN=carthageworkshop.com
PUBLIC_SHOPIFY_STOREFRONT_TOKEN=

# HTTP API created by infra/template.yaml (output "ApiUrl"), e.g. https://abc123.execute-api.us-east-1.amazonaws.com
PUBLIC_API_URL=

# Social
PUBLIC_YOUTUBE_CHANNEL_ID=        # optional; resolved from @jholtillus when blank
PUBLIC_TWITTER_HANDLE=jholtillus
