---
// Enquiry form -> POST {PUBLIC_API_URL}/contact -> Lambda -> SES email (reply-to = sender).
const types = ['Commission', 'Publishing', 'Order question', 'Other'];
---
<form class="cf" data-contact novalidate>
  <fieldset class="types">
    <legend>What’s this about?</legend>
    <div class="pills">
      {types.map((t, i) => <label class="pill"><input type="radio" name="type" value={t} checked={i === 0} /><span>{t}</span></label>)}
    </div>
  </fieldset>
  <div class="two">
    <div class="field"><label for="cf-name">Name</label><input id="cf-name" name="name" required autocomplete="name" /></div>
    <div class="field"><label for="cf-email">Email</label><input id="cf-email" name="email" type="email" required autocomplete="email" /></div>
  </div>
  <div class="field"><label for="cf-msg">Message</label><textarea id="cf-msg" name="message" required rows="6" placeholder="A few lines about the project: what it is, rough timeline and budget."></textarea></div>
  <input type="text" name="company" tabindex="-1" autocomplete="off" class="hp" aria-hidden="true" />
  <div class="row">
    <button class="btn solid" type="submit">Send message</button>
    <p class="msg" data-msg role="status" aria-live="polite"></p>
  </div>
</form>
<style>
  .cf { display: grid; gap: 28px; }
  .types { border: 0; padding: 0; margin: 0; }
  legend, .field label { display: block; padding: 0; margin: 0 0 10px; font: 500 11px/1 var(--sans); letter-spacing: .14em; text-transform: uppercase; color: var(--muted); }
  .pills { display: flex; flex-wrap: wrap; gap: 8px; }
  .pill { position: relative; margin: 0; text-transform: none; letter-spacing: 0; }
  .pill input { position: absolute; inset: 0; opacity: 0; margin: 0; width: 100%; height: 100%; cursor: pointer; }
  .pill span { display: inline-flex; align-items: center; min-height: 38px; padding: 0 16px; border: 1px solid var(--line); border-radius: 19px; font: 400 13px/1 var(--sans); color: var(--fg); transition: all .2s; }
  .pill:hover span { border-color: var(--fg); }
  .pill input:checked + span { background: var(--fg); border-color: var(--fg); color: #fff; }
  .pill input:focus-visible + span { outline: 1px solid var(--fg); outline-offset: 2px; }
  .two { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; }
  .field input, .field textarea { padding: 10px 0; }
  .field textarea { min-height: 150px; }
  .row { display: flex; align-items: center; gap: 20px; flex-wrap: wrap; }
  .msg { margin: 0; font-size: 14px; color: var(--muted); }
  @media (max-width: 560px) { .two { grid-template-columns: 1fr; } .row .btn { width: 100%; } }
</style>
<script>
  const api = import.meta.env.PUBLIC_API_URL;
  document.querySelectorAll<HTMLFormElement>('[data-contact]').forEach((form) => {
    const msg = form.querySelector<HTMLElement>('[data-msg]')!;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = Object.fromEntries(new FormData(form)) as Record<string, string>;
      if (!data.name || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(data.email || '') || !data.message) { msg.textContent = 'Please add your name, a valid email and a message.'; return; }
      const btn = form.querySelector<HTMLButtonElement>('button[type=submit]')!; btn.disabled = true; btn.textContent = 'Sending…';
      try {
        if (!api) throw new Error('no api');
        const r = await fetch(`${api}/contact`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) });
        if (!r.ok) throw new Error();
        form.reset(); msg.textContent = 'Thank you. Your message has been sent.';
      } catch { msg.textContent = api ? 'The message didn’t send. Please try again in a moment.' : 'The form isn’t connected yet (PUBLIC_API_URL not set).'; }
      finally { btn.disabled = false; btn.textContent = 'Send message'; }
    });
  });
</script>
