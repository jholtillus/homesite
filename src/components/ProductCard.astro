---
import type { Product } from '../data/site';
import { formatPrice } from '../data/shopify';
interface Props { product: Product; }
const { product: p } = Astro.props;
---
<a href={`/shop/${p.handle}/`} class="pc reveal" data-type={p.type}>
  <div class="img-frame"><img src={p.image} alt={p.title} loading="lazy" width="600" height="750" /></div>
  <div class="meta">
    <div><p class="eyebrow">{p.type}</p><h3>{p.title}</h3></div>
    <span class="price">{p.available ? formatPrice(p.price, p.currency) : 'Sold'}</span>
  </div>
</a>
<style>
  .pc { display: block; }
  .img-frame { aspect-ratio: 4 / 5; }
  .meta { display: flex; justify-content: space-between; gap: 16px; padding-top: 16px; align-items: start; }
  h3 { font-size: 1.3rem; margin-top: 8px; }
  .price { font-size: 14px; white-space: nowrap; padding-top: 22px; }
</style>
