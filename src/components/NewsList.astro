---
import type { NewsItem } from '../data/site';
interface Props { items: NewsItem[]; }
const { items } = Astro.props;
const fmt = (d?: string) => (d ? new Date(d + 'T12:00:00').toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : 'New');
---
<ul class="news">
  {items.map((n) => {
    const ext = n.href.startsWith('http');
    return (
      <li>
        <a href={n.href} target={ext ? '_blank' : undefined} rel={ext ? 'noopener' : undefined}>
          {n.image ? <span class="thumb frame"><img src={n.image} alt="" loading="lazy" /></span> : <span class="thumb frame" />}
          <span class="body">
            <span class="eyebrow">{fmt(n.date)} · {n.source}</span>
            <span class="t">{n.title}</span>
            <span class="s">{n.summary}</span>
          </span>
        </a>
      </li>
    );
  })}
</ul>
<style>
  .news { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  li { border-bottom: 1px solid var(--line); }
  a { display: grid; grid-template-columns: 132px 1fr; gap: 22px; align-items: center; padding: 18px 0; }
  .thumb { aspect-ratio: 4/3; }
  .body { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .t { font-size: 1.08rem; line-height: 1.4; }
  .s { font-size: 13.5px; color: var(--muted); line-height: 1.6; }
  a:hover .t { text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1px; }
  @media (max-width: 520px) { a { grid-template-columns: 88px 1fr; gap: 14px; } .s { display: none; } }
</style>
