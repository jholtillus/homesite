---
import { site, nav, social, projects } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="ftr">
  <div class="wrap cols">
    <div class="brand">
      <a href="/" class="logo">{site.name}</a>
      <p class="muted">{site.tagline}</p>
      <a href={`mailto:${site.email}`} class="mail">{site.email}</a>
    </div>
    <div>
      <p class="eyebrow">Site</p>
      <ul>{nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul>
    </div>
    <div>
      <p class="eyebrow">Projects</p>
      <ul>{projects.map((p) => <li><a href={`/projects/${p.slug}/`}>{p.title}</a></li>)}</ul>
      <p class="eyebrow" style="margin-top:28px">Store</p>
      <ul><li><a href={`https://${site.shopDomain}`} target="_blank" rel="noopener">Carthage Workshop</a></li></ul>
    </div>
    <div>
      <p class="eyebrow">Follow</p>
      <ul>{social.map((s) => <li><a href={s.href} target="_blank" rel="noopener">{s.label}</a></li>)}<li><a href="/rss.xml">RSS</a></li></ul>
    </div>
  </div>
  <div class="wrap legal">
    <span>© {year} {site.name}. All artwork © the artist.</span>
    <span>Checkout powered by Shopify</span>
  </div>
</footer>

<style>
  .ftr { border-top: 1px solid var(--line); padding: 72px 0 32px; margin-top: 0; }
  .cols { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 40px; }
  .logo { font: 400 1.8rem/1 var(--serif); }
  .brand p { margin: 12px 0 18px; }
  .mail { border-bottom: 1px solid var(--line); padding-bottom: 2px; }
  ul { list-style: none; padding: 0; margin: 16px 0 0; display: grid; gap: 10px; font-size: 15px; }
  ul a:hover, .mail:hover { color: var(--muted); }
  .legal { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px; margin-top: 64px; padding-top: 24px; border-top: 1px solid var(--line); font-size: 12px; color: var(--muted); letter-spacing: .03em; }
  @media (max-width: 860px) { .cols { grid-template-columns: 1fr 1fr; } .brand { grid-column: 1 / -1; } }
</style>
