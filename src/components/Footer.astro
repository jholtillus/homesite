---
import Newsletter from './Newsletter.astro';
import { site } from '../data/site';
interface Props { newsletter?: boolean }
const year = new Date().getFullYear();
---
<footer class="ftr">
  <Newsletter />
  <div class="legal">
    <span>© {year} {site.name}. All artwork © {site.name}.</span>
    <span><a href={`https://${site.shopDomain}`} target="_blank" rel="noopener">Carthage Workshop</a> · <a href="/rss.xml">RSS</a> · Checkout by Shopify</span>
  </div>
</footer>
<style>
  .ftr { padding: 0 var(--pad) 28px; max-width: 1500px; }
  .legal { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 10px; padding-top: 22px; border-top: 1px solid var(--line); font-size: 12px; color: var(--muted); }
  .legal a:hover { color: var(--fg); }
</style>
