---
import type { Project } from '../data/site';
interface Props { project: Project; }
const { project: p } = Astro.props;
---
<a href={`/projects/${p.slug}/`} class="pj">
  <div class="frame"><img src={p.cover.src} alt={p.cover.alt} loading="lazy" decoding="async" width={p.cover.w} height={p.cover.h} /></div>
  <p class="eyebrow">{p.kicker}{p.status === 'Upcoming' ? ' · Upcoming' : ''}</p>
  <h3>{p.title}</h3>
  {p.partner && <p class="partner">{p.partner}</p>}
</a>
<style>
  .pj { display: block; }
  .frame { aspect-ratio: 4/5; }
  .eyebrow { margin: 14px 0 4px; }
  h3 { font-size: 1.12rem; font-style: italic; }
  .partner { font-size: 12.5px; color: var(--muted); margin: 4px 0 0; }
  .pj:hover h3 { text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1px; }
</style>
