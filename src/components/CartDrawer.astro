---
import { site } from '../data/site';
---
<div class="scrim" data-cart-scrim hidden></div>
<aside class="drawer" data-cart-drawer aria-label="Cart" aria-hidden="true">
  <div class="top">
    <span class="eyebrow">Your cart</span>
    <button data-cart-close aria-label="Close cart" class="x">Close</button>
  </div>
  <div class="lines" data-cart-lines></div>
  <div class="empty" data-cart-empty>
    <p class="serif">Your cart is empty.</p>
    <a href="/shop/" class="link-arrow">Browse the shop</a>
  </div>
  <div class="foot" data-cart-foot>
    <div class="row"><span>Subtotal</span><span data-cart-subtotal></span></div>
    <p class="note">Shipping and taxes are calculated at checkout on {site.shopDomain}.</p>
    <button class="btn solid block" data-cart-checkout>Checkout</button>
  </div>
</aside>

<style>
  .scrim { position: fixed; inset: 0; background: rgba(0,0,0,.25); z-index: 90; opacity: 0; transition: opacity .3s; }
  .scrim.on { opacity: 1; }
  .drawer { position: fixed; top: 0; right: 0; bottom: 0; width: min(440px, 100%); background: var(--bg); z-index: 100; display: flex; flex-direction: column; transform: translateX(100%); visibility: hidden; transition: transform .45s var(--ease), visibility 0s .45s; box-shadow: -20px 0 60px rgba(0,0,0,.06); }
  .drawer.on { transform: none; visibility: visible; transition: transform .45s var(--ease); }
  .top { display: flex; justify-content: space-between; align-items: center; height: var(--header); padding: 0 28px; border-bottom: 1px solid var(--line); }
  .x { font: 400 12px/1 var(--sans); letter-spacing: .12em; text-transform: uppercase; }
  .lines { flex: 1; overflow-y: auto; padding: 8px 28px; }
  .empty { flex: 1; padding: 48px 28px; }
  .empty .serif { font: 400 1.6rem/1.3 var(--serif); margin-bottom: 20px; }
  .foot { padding: 24px 28px 28px; border-top: 1px solid var(--line); }
  .row { display: flex; justify-content: space-between; font-weight: 400; }
  .note { font-size: 13px; color: var(--muted); margin: 8px 0 20px; }
  :global(.cl) { display: grid; grid-template-columns: 76px 1fr auto; gap: 16px; padding: 20px 0; border-bottom: 1px solid var(--line); align-items: start; }
  :global(.cl img) { width: 76px; height: 96px; object-fit: cover; background: var(--soft); }
  :global(.cl h4) { margin: 0 0 4px; font: 400 1.15rem/1.2 var(--serif); }
  :global(.cl .v) { font-size: 13px; color: var(--muted); }
  :global(.cl .q) { display: inline-flex; align-items: center; border: 1px solid var(--line); margin-top: 10px; }
  :global(.cl .q button) { width: 30px; height: 30px; }
  :global(.cl .q span) { min-width: 24px; text-align: center; font-size: 14px; }
  :global(.cl .p) { text-align: right; font-size: 14px; }
  :global(.cl .rm) { display: block; margin-top: 10px; font-size: 12px; color: var(--muted); text-decoration: underline; text-underline-offset: 3px; }
</style>

<script>
  import { cart, money } from '../scripts/cart';
  const $ = <T extends Element>(s: string) => document.querySelector<T>(s)!;
  const drawer = $<HTMLElement>('[data-cart-drawer]'), scrim = $<HTMLElement>('[data-cart-scrim]');
  const linesEl = $<HTMLElement>('[data-cart-lines]'), emptyEl = $<HTMLElement>('[data-cart-empty]'), footEl = $<HTMLElement>('[data-cart-foot]');
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

  function open() { scrim.hidden = false; requestAnimationFrame(() => { scrim.classList.add('on'); drawer.classList.add('on'); }); drawer.setAttribute('aria-hidden', 'false'); document.body.style.overflow = 'hidden'; }
  function close() { scrim.classList.remove('on'); drawer.classList.remove('on'); drawer.setAttribute('aria-hidden', 'true'); document.body.style.overflow = ''; setTimeout(() => (scrim.hidden = true), 300); }

  function render() {
    const lines = cart.lines();
    emptyEl.hidden = lines.length > 0; footEl.hidden = linesEl.hidden = lines.length === 0;
    linesEl.innerHTML = lines.map((l) => `
      <div class="cl" data-id="${esc(l.variantId)}">
        <a href="/shop/${esc(l.handle)}/"><img src="${esc(l.image)}" alt=""></a>
        <div><h4>${esc(l.title)}</h4>${l.variantTitle && l.variantTitle !== 'Default' && l.variantTitle !== 'Default Title' ? `<div class="v">${esc(l.variantTitle)}</div>` : ''}
          <div class="q"><button data-dec aria-label="Decrease quantity">−</button><span>${l.qty}</span><button data-inc aria-label="Increase quantity">+</button></div></div>
        <div class="p">${money(Number(l.price) * l.qty, l.currency)}<button class="rm" data-rm>Remove</button></div>
      </div>`).join('');
    $<HTMLElement>('[data-cart-subtotal]').textContent = money(cart.subtotal(), lines[0]?.currency);
  }

  linesEl.addEventListener('click', (e) => {
    const t = e.target as HTMLElement, row = t.closest<HTMLElement>('.cl'); if (!row) return;
    const id = row.dataset.id!, line = cart.lines().find((l) => l.variantId === id)!;
    if (t.closest('[data-inc]')) cart.setQty(id, line.qty + 1);
    if (t.closest('[data-dec]')) cart.setQty(id, line.qty - 1);
    if (t.closest('[data-rm]')) cart.remove(id);
  });
  document.querySelectorAll('[data-cart-open]').forEach((b) => b.addEventListener('click', open));
  $('[data-cart-close]').addEventListener('click', close); scrim.addEventListener('click', close);
  addEventListener('keydown', (e) => e.key === 'Escape' && drawer.classList.contains('on') && close());
  document.addEventListener('cart:open', open);
  document.addEventListener('cart:change', render);
  const co = $<HTMLButtonElement>('[data-cart-checkout]');
  co.addEventListener('click', async () => { co.disabled = true; co.textContent = 'Redirecting…'; try { await cart.checkout(); } finally { setTimeout(() => { co.disabled = false; co.textContent = 'Checkout'; }, 4000); } });
  render();
</script>
