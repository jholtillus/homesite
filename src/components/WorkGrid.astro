---
import type { Artwork } from '../data/site';
interface Props { items: Artwork[]; filters?: boolean; }
const { items, filters = false } = Astro.props;
const cats = ['All', ...new Set(items.map((i) => i.category))];
---
{filters && (
  <div class="filters" role="tablist" aria-label="Filter work">
    {cats.map((c, i) => <button role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-filter={c}>{c}</button>)}
  </div>
)}
<div class="masonry" data-grid>
  {items.map((a, i) => (
    <figure class="item reveal" data-cat={a.category}>
      <button class="open" data-lb={i} aria-label={`View ${a.title}`}>
        <div class="img-frame" style={`aspect-ratio:${a.w}/${a.h}`}><img src={a.image} alt={a.title} loading="lazy" width={a.w} height={a.h} /></div>
      </button>
      <figcaption><span>{a.title}</span><span class="muted">{a.year}</span></figcaption>
    </figure>
  ))}
</div>

<div class="lb" data-lightbox hidden role="dialog" aria-modal="true" aria-label="Artwork viewer">
  <button class="lb-x" data-lb-close>Close</button>
  <button class="lb-nav prev" data-lb-prev aria-label="Previous">←</button>
  <figure><img data-lb-img alt="" /><figcaption data-lb-cap></figcaption></figure>
  <button class="lb-nav next" data-lb-next aria-label="Next">→</button>
</div>
<script type="application/json" data-lb-data set:html={JSON.stringify(items.map((a) => ({ src: a.image, title: a.title, meta: `${a.medium}, ${a.year}` })))} />

<style>
  .filters { display: flex; flex-wrap: wrap; gap: 8px 28px; margin-bottom: 40px; }
  .filters button { font: 400 13px/1 var(--sans); letter-spacing: .08em; text-transform: uppercase; color: var(--muted); padding: 6px 0; border-bottom: 1px solid transparent; }
  .filters button[aria-selected='true'] { color: var(--fg); border-color: var(--fg); }
  .masonry { columns: 3 320px; column-gap: clamp(16px, 2.4vw, 32px); }
  .item { break-inside: avoid; margin: 0 0 clamp(28px, 3.5vw, 48px); }
  .item[hidden] { display: none; }
  .open { display: block; width: 100%; cursor: zoom-in; }
  .open:hover img { transform: scale(1.025); }
  figcaption { display: flex; justify-content: space-between; gap: 12px; padding-top: 12px; font-size: 14px; }
  .lb { position: fixed; inset: 0; z-index: 200; background: rgba(255,255,255,.98); display: grid; grid-template-columns: 64px 1fr 64px; align-items: center; }
  .lb[hidden] { display: none; }
  .lb figure { margin: 0; height: 100vh; height: 100dvh; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 72px 0 32px; }
  .lb img { max-height: calc(100dvh - 160px); max-width: 100%; object-fit: contain; }
  .lb figcaption { display: block; text-align: center; font-family: var(--serif); font-size: 1.2rem; }
  .lb figcaption small { display: block; font: 300 13px var(--sans); color: var(--muted); margin-top: 4px; }
  .lb-x { position: absolute; top: 24px; right: var(--gutter); font: 400 12px/1 var(--sans); letter-spacing: .12em; text-transform: uppercase; z-index: 1; }
  .lb-nav { font-size: 24px; height: 100%; }
  @media (max-width: 700px) { .lb { grid-template-columns: 1fr; } .lb-nav { position: absolute; bottom: 16px; height: 48px; width: 48px; } .prev { left: 16px; } .next { right: 16px; } .lb figure { padding: 64px 16px 80px; } }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-grid]').forEach((grid) => {
    const root = grid.parentElement!;
    const data = JSON.parse(root.querySelector('[data-lb-data]')!.textContent!);
    const lb = root.querySelector<HTMLElement>('[data-lightbox]')!, img = lb.querySelector<HTMLImageElement>('[data-lb-img]')!, cap = lb.querySelector<HTMLElement>('[data-lb-cap]')!;
    const items = [...grid.querySelectorAll<HTMLElement>('.item')];
    let cur = 0;
    const visible = () => items.map((el, i) => (el.hidden ? -1 : i)).filter((i) => i >= 0);
    const show = (i: number) => { cur = i; img.src = data[i].src; img.alt = data[i].title; cap.innerHTML = ''; cap.append(data[i].title); const s = document.createElement('small'); s.textContent = data[i].meta; cap.append(s); };
    const step = (d: number) => { const v = visible(); show(v[(v.indexOf(cur) + d + v.length) % v.length]); };
    const close = () => { lb.hidden = true; document.body.style.overflow = ''; };
    grid.addEventListener('click', (e) => { const b = (e.target as HTMLElement).closest<HTMLElement>('[data-lb]'); if (!b) return; show(+b.dataset.lb!); lb.hidden = false; document.body.style.overflow = 'hidden'; });
    lb.querySelector('[data-lb-close]')!.addEventListener('click', close);
    lb.querySelector('[data-lb-prev]')!.addEventListener('click', () => step(-1));
    lb.querySelector('[data-lb-next]')!.addEventListener('click', () => step(1));
    addEventListener('keydown', (e) => { if (lb.hidden) return; if (e.key === 'Escape') close(); if (e.key === 'ArrowLeft') step(-1); if (e.key === 'ArrowRight') step(1); });
    let x0 = 0; lb.addEventListener('touchstart', (e) => (x0 = e.touches[0].clientX), { passive: true });
    lb.addEventListener('touchend', (e) => { const dx = e.changedTouches[0].clientX - x0; if (Math.abs(dx) > 50) step(dx < 0 ? 1 : -1); });
    root.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((b, _, all) => b.addEventListener('click', () => {
      all.forEach((x) => x.setAttribute('aria-selected', String(x === b)));
      items.forEach((el) => (el.hidden = b.dataset.filter !== 'All' && el.dataset.cat !== b.dataset.filter));
    }));
  });
</script>
