---
// About: personal page. Items marked PLACEHOLDER are waiting for real details and photos.
import Base from '../layouts/Base.astro';
import { site, social } from '../data/site';
const facts = [
  { label: 'Also known as', value: site.alias },
  { label: 'Works in', value: 'Watercolor and ink' },
  { label: 'Day job', value: 'Art professor' },
  { label: 'Draws', value: 'History, myth, religion and literature' },
  { label: 'Based in', value: 'PLACEHOLDER — city, state' },
];
const influences = ['PLACEHOLDER — an illustrator', 'PLACEHOLDER — a cartoonist', 'PLACEHOLDER — a painter', 'PLACEHOLDER — a book'];
---
<Base title="About" description={site.intro}>
  <div class="page">
    <section class="intro">
      <div class="photo ph-box" role="img" aria-label="Portrait photo placeholder"><span>Portrait photo<br /><small>PLACEHOLDER</small></span></div>
      <div class="txt">
        <p class="eyebrow">About</p>
        <h1>Hello, I’m Jordan.</h1>
        <p class="lede">{site.intro}</p>
        <dl>{facts.map((f) => <div><dt>{f.label}</dt><dd class:list={{ ph: f.value.startsWith('PLACEHOLDER') }}>{f.value}</dd></div>)}</dl>
      </div>
    </section>

    <section class="story">
      <div class="block">
        <h2>A bit about me</h2>
        <div class="copy">
          <p class="ph">PLACEHOLDER — where you grew up, and the first drawings, comics or books that made you want to do this.</p>
          <p class="ph">PLACEHOLDER — how you trained, and the path from there to illustrating books, games and graphic novels.</p>
        </div>
      </div>
      <div class="block">
        <h2>In the studio</h2>
        <div class="copy">
          <p>Most of my individual pieces are watercolor and ink.</p>
          <p class="ph">PLACEHOLDER — a typical day at the drawing table: favorite papers, brushes and pens, and how a piece goes from thumbnail to finished painting.</p>
        </div>
      </div>
      <div class="block">
        <h2>Teaching</h2>
        <div class="copy">
          <p>Alongside my own work, I’m an art professor.</p>
          <p class="ph">PLACEHOLDER — what you teach, where, and what teaching has taught you about your own work.</p>
        </div>
      </div>
      <div class="block">
        <h2>Outside the studio</h2>
        <div class="copy">
          <p class="ph">PLACEHOLDER — family, faith, reading, games, places you love to visit. A few lines that make this feel like you.</p>
        </div>
      </div>
      <div class="block">
        <h2>Influences</h2>
        <ul class="infl">{influences.map((i) => <li class="ph">{i}</li>)}</ul>
      </div>
    </section>

    <div class="studio ph-box" role="img" aria-label="Studio photo placeholder"><span>Studio or drawing-table photo<br /><small>PLACEHOLDER</small></span></div>

    <section class="end">
      <div>
        <h2>Say hello</h2>
        <p class="muted">For commissions, publishing or just to talk shop. You can also find me on {social.slice(0, 3).map((s, i) => <>{i > 0 && (i === 2 ? ' and ' : ', ')}<a href={s.href} target="_blank" rel="noopener" class="u">{s.label}</a></>)}.</p>
      </div>
      <a href="/contact/" class="btn solid">Start a conversation</a>
    </section>
  </div>
</Base>
<style>
  .ph-box { display: grid; place-items: center; background: var(--soft); border: 1px dashed #cfcac3; text-align: center; color: var(--muted); font: italic 400 1.2rem/1.4 var(--serif); }
  .ph-box small { font: 400 10px/2 var(--sans); letter-spacing: .2em; font-style: normal; }
  .ph { color: var(--muted); font-style: italic; }
  .intro { display: grid; grid-template-columns: minmax(260px, 1fr) 1.3fr; gap: clamp(28px, 6vw, 96px); align-items: center; }
  .photo { aspect-ratio: 4 / 5; }
  .txt h1 { margin: 16px 0 20px; }
  .txt .lede { margin-bottom: 32px; max-width: 46ch; }
  dl { margin: 0; border-top: 1px solid var(--line); }
  dl div { display: grid; grid-template-columns: 140px 1fr; gap: 16px; padding: 12px 0; border-bottom: 1px solid var(--line); font-size: 14px; }
  dt { color: var(--muted); } dd { margin: 0; }
  .story { margin-top: clamp(64px, 9vw, 120px); display: grid; gap: clamp(40px, 5vw, 64px); }
  .block { display: grid; grid-template-columns: 1fr 2fr; gap: clamp(16px, 5vw, 80px); padding-top: 28px; border-top: 1px solid var(--line); }
  .block h2 { font-size: clamp(1.6rem, 2.6vw, 2.2rem); }
  .copy { max-width: 62ch; }
  .copy p { font-size: 1.05rem; line-height: 1.8; }
  .infl { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; font: 400 1.2rem/1.4 var(--serif); }
  .studio { aspect-ratio: 21 / 9; margin-top: clamp(64px, 9vw, 112px); }
  .end { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 24px; margin-top: clamp(56px, 7vw, 96px); padding: 40px 0 96px; border-top: 1px solid var(--line); }
  .end h2 { margin-bottom: 8px; }
  .end p { margin: 0; }
  @media (max-width: 820px) { .intro, .block { grid-template-columns: 1fr; } .photo { max-width: 420px; } .studio { aspect-ratio: 3 / 2; } dl div { grid-template-columns: 110px 1fr; } }
</style>
