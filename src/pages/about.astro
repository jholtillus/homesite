---
import Base from '../layouts/Base.astro';
import { site, projects, upcoming } from '../data/site';
const done = projects.filter((p) => p.status !== 'Upcoming');
---
<Base title="About" description={site.intro}>
  <div class="page about">
    <div class="art"><img src="/images/art/wanderer.jpg" alt="Mithrandir, ink and natural pigment watercolors" width="713" height="1049" /></div>
    <div class="txt">
      <h1>{site.name}</h1>
      <p class="lede">{site.tagline}</p>
      <p>{site.intro}</p>
      <h2>Major projects</h2>
      <ul class="list">
        {done.map((p) => <li><a href={`/projects/${p.slug}/`}><em>{p.title}</em></a><span>{p.kicker}{p.partner ? ` · ${p.partner}` : ''}</span></li>)}
      </ul>
      <h2>Upcoming</h2>
      <ul class="list">{upcoming.map((u) => <li><span class="plain">{u}</span></li>)}</ul>
      <h2>Work with me</h2>
      <p>Illustration for books, games, comics and graphic novels — covers, interiors, sequential art and private commissions. Prices depend on scale, timeline and medium.</p>
      <a href="/contact/" class="btn solid">Start a conversation</a>
    </div>
  </div>
</Base>
<style>
  .about { display: grid; grid-template-columns: minmax(240px, 1fr) 1.3fr; gap: clamp(28px, 6vw, 88px); align-items: start; }
  .art { position: sticky; top: 32px; }
  h1 { margin-bottom: 10px; }
  .lede { margin-bottom: 22px; }
  h2 { font-size: 1.2rem; margin: 40px 0 12px; }
  .list { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--line); }
  .list li { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; padding: 11px 0; border-bottom: 1px solid var(--line); font-size: 14px; }
  .list li > span:not(.plain) { color: var(--muted); font-size: 12.5px; }
  .list a:hover em { text-decoration: underline; text-underline-offset: 3px; }
  .btn { margin-top: 8px; }
  @media (max-width: 860px) { .about { grid-template-columns: 1fr; } .art { position: static; max-width: 420px; } }
</style>
