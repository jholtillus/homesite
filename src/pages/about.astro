---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---
<Base title="About" description="About Jordan Holt — illustrator and cartoonist.">
  <section class="wrap about">
    <div class="img-frame reveal"><img src="/images/portrait.svg" alt="Portrait of Jordan Holt" width="1200" height="1500" /></div>
    <div class="txt">
      <p class="eyebrow">About</p>
      <h1>Jordan Holt</h1>
      <p class="lede">Illustrator and cartoonist working in comics, editorial illustration and fine art.</p>
      <p>PLACEHOLDER BIO — replace with a short biography: background, teaching, publications, notable clients and exhibitions.</p>
      <p>Creator of <a href="/projects/theseus/" class="u">Theseus</a>, a satirical retelling of the Greek myth, and <a href="/projects/panomachea/" class="u">Panomachea</a>. Books, prints and originals are published through <a href={`https://${site.shopDomain}`} class="u" target="_blank" rel="noopener">Carthage Workshop</a>.</p>
      <h3>Services</h3>
      <ul class="svc"><li>Book &amp; cover illustration</li><li>Editorial illustration</li><li>Comics &amp; sequential art</li><li>Private commissions</li></ul>
      <div style="margin-top:40px"><a href="/contact/" class="btn solid">Enquire about a commission</a></div>
    </div>
  </section>
</Base>
<style>
  .about { display: grid; grid-template-columns: 1fr 1.1fr; gap: clamp(32px, 7vw, 112px); padding-top: clamp(48px, 8vw, 112px); padding-bottom: 120px; align-items: start; }
  .about .img-frame { aspect-ratio: 4/5; position: sticky; top: calc(var(--header) + 32px); }
  h1 { margin: 16px 0 24px; }
  .lede { margin-bottom: 28px; }
  .u { border-bottom: 1px solid currentColor; }
  h3 { margin: 48px 0 12px; }
  .svc { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--line); }
  .svc li { padding: 14px 0; border-bottom: 1px solid var(--line); }
  @media (max-width: 820px) { .about { grid-template-columns: 1fr; } .about .img-frame { position: static; } }
</style>
