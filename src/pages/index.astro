---
import Base from '../layouts/Base.astro';
import WorkGrid from '../components/WorkGrid.astro';
import ProductCard from '../components/ProductCard.astro';
import NewsList from '../components/NewsList.astro';
import Newsletter from '../components/Newsletter.astro';
import { artwork, projects, studioNews, site, social } from '../data/site';
import { getProducts } from '../data/shopify';
import { getYouTube } from '../data/youtube';

const products = (await getProducts()).slice(0, 4);
const news = [...(await getYouTube(site.youtubeChannelId, 3)), ...studioNews].sort((a, b) => b.date.localeCompare(a.date)).slice(0, 4);
---
<Base>
  <section class="hero wrap">
    <div class="intro reveal">
      <p class="eyebrow">Illustrator · Cartoonist</p>
      <h1>Pictures for<br /><em>old stories</em> &amp; new ones.</h1>
      <p class="lede muted">Comics, illustration and original art — available for commission, collected in print.</p>
      <div class="ctas"><a href="/work/" class="btn solid">View work</a><a href="/contact/" class="btn">Commission</a></div>
    </div>
    <a href="/projects/theseus/" class="feature reveal">
      <div class="img-frame"><img src={artwork[0].image} alt={artwork[0].title} width="1200" height="1600" fetchpriority="high" /></div>
      <span class="cap"><span>{artwork[0].title}</span><span class="muted">Featured</span></span>
    </a>
  </section>

  <section class="section wrap">
    <div class="section-head"><h2>Selected work</h2><a href="/work/" class="link-arrow">All work</a></div>
    <WorkGrid items={artwork.slice(0, 6)} />
  </section>

  <section class="section">
    <div class="wrap section-head"><h2>Projects</h2><a href="/projects/" class="link-arrow">All projects</a></div>
    <div class="wrap projects">
      {projects.map((p) => (
        <a href={`/projects/${p.slug}/`} class="proj reveal">
          <div class="img-frame"><img src={p.hero} alt={p.title} loading="lazy" width="2400" height="1200" /></div>
          <div class="pmeta"><p class="eyebrow">{p.kicker} · {p.status}</p><h3>{p.title}</h3><p class="muted">{p.summary}</p><span class="link-arrow">Explore</span></div>
        </a>
      ))}
    </div>
  </section>

  <section class="section wrap">
    <div class="section-head"><div><p class="eyebrow">Carthage Workshop</p><h2 style="margin-top:14px">Originals, prints &amp; books</h2></div><a href="/shop/" class="link-arrow">Shop all</a></div>
    <div class="shop-grid">{products.map((p) => <ProductCard product={p} />)}</div>
  </section>

  <section class="section wrap">
    <div class="news-grid">
      <div>
        <div class="section-head"><h2>News</h2><a href="/news/" class="link-arrow">All updates</a></div>
        <NewsList items={news} />
      </div>
      <aside class="follow reveal">
        <p class="eyebrow">Follow along</p>
        <p class="lede">Process videos on YouTube, sketches and announcements on X.</p>
        <ul>{social.map((s) => <li><a href={s.href} target="_blank" rel="noopener"><span>{s.label}</span><span>↗</span></a></li>)}</ul>
      </aside>
    </div>
  </section>

  <Newsletter />
</Base>

<style>
  .hero { display: grid; grid-template-columns: 1.05fr 1fr; gap: clamp(32px, 6vw, 96px); align-items: center; padding-top: clamp(40px, 7vw, 96px); padding-bottom: clamp(56px, 8vw, 120px); }
  h1 em { font-style: italic; }
  .intro h1 { margin: 20px 0 28px; }
  .ctas { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 36px; }
  .feature .img-frame { aspect-ratio: 4 / 5; }
  .cap { display: flex; justify-content: space-between; padding-top: 12px; font-size: 14px; }
  .projects { display: grid; gap: clamp(48px, 7vw, 96px); }
  .proj { display: grid; grid-template-columns: 1.6fr 1fr; gap: clamp(24px, 4vw, 64px); align-items: end; }
  .proj:nth-child(even) { grid-template-columns: 1fr 1.6fr; }
  .proj:nth-child(even) .img-frame { order: 2; }
  .proj .img-frame { aspect-ratio: 2 / 1; }
  .pmeta h3 { font-size: clamp(2.2rem, 4vw, 3.4rem); margin: 14px 0 16px; }
  .pmeta .muted { max-width: 38ch; margin-bottom: 24px; }
  .shop-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(16px, 2.4vw, 32px); }
  .news-grid { display: grid; grid-template-columns: 2fr 1fr; gap: clamp(32px, 6vw, 96px); }
  .follow { background: var(--soft); padding: 40px; align-self: start; }
  .follow .lede { margin: 16px 0 24px; font-size: 1.4rem; }
  .follow ul { list-style: none; padding: 0; margin: 0; border-top: 1px solid #ddd; }
  .follow li a { display: flex; justify-content: space-between; padding: 16px 0; border-bottom: 1px solid #ddd; font-size: 15px; }
  .follow li a:hover { padding-left: 6px; transition: padding .3s var(--ease); }
  @media (max-width: 1000px) { .shop-grid { grid-template-columns: repeat(2, 1fr); } .news-grid { grid-template-columns: 1fr; } }
  @media (max-width: 820px) {
    .hero { grid-template-columns: 1fr; }
    .proj, .proj:nth-child(even) { grid-template-columns: 1fr; }
    .proj:nth-child(even) .img-frame { order: 0; }
    .proj .img-frame { aspect-ratio: 3 / 2; }
  }
  @media (max-width: 480px) { .follow { padding: 28px 20px; } }
</style>
