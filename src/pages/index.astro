---
import Base from '../layouts/Base.astro';
import Gallery from '../components/Gallery.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ProductCard from '../components/ProductCard.astro';
import NewsList from '../components/NewsList.astro';
import ContactForm from '../components/ContactForm.astro';
import { artwork, projects, site } from '../data/site';
import { getProducts } from '../data/shopify';
import { getNews } from '../data/feeds';

const all = await getProducts();
const featured = ['theseus-the-full-collection', 'panomachea-deluxe', 'theseus-vol-3-hardcover', 'panomachea-battle-with-gods-heroes-monsters']
  .map((h) => all.find((p) => p.handle === h)).filter(Boolean) as typeof all;
const shop = featured.length ? featured : all.slice(0, 4);
const news = await getNews(3);
---
<Base>
  <div class="page">
    <section class="m-intro">
      <p class="tag">{site.tagline}</p>
      <p class="intro">{site.intro}</p>
    </section>

    <Gallery items={artwork} />

    <hr class="rule" />

    <section class="commission">
      <div>
        <h2>Commissions</h2>
        <p class="muted">If you’re interested in having a project illustrated, you can start the conversation here. Commissioned work prices depend on scale, timeline, medium, and many more variables. Let’s discuss.</p>
        <a href="/contact/" class="link">More about working together</a>
      </div>
      <ContactForm compact />
    </section>

    <section class="section">
      <div class="section-head"><h2>Projects</h2><a href="/projects/" class="link">All projects</a></div>
      <div class="pgrid">{projects.map((p) => <ProjectCard project={p} />)}</div>
    </section>

    <section class="section">
      <div class="section-head"><h2>From Carthage Workshop</h2><a href="/shop/" class="link">Visit the shop</a></div>
      <div class="sgrid">{shop.map((p) => <ProductCard product={p} />)}</div>
    </section>

    {news.length > 0 && (
      <section class="section">
        <div class="section-head"><h2>News</h2><a href="/news/" class="link">All updates</a></div>
        <NewsList items={news} />
      </section>
    )}
  </div>
</Base>

<style>
  .m-intro { display: none; }
  .commission { display: grid; grid-template-columns: 1fr 1.2fr; gap: clamp(24px, 5vw, 72px); align-items: start; }
  .commission h2 { margin-bottom: 14px; }
  .commission .muted { font-size: 14px; }
  .pgrid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 22px; }
  .sgrid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 22px; }
  @media (max-width: 1400px) { .pgrid { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 1099px) {
    .m-intro { display: block; margin-bottom: 24px; }
    .m-intro .tag { font-size: 1.15rem; line-height: 1.55; margin-bottom: 10px; }
    .m-intro .intro { font-size: 13.5px; font-style: italic; color: var(--muted); max-width: 60ch; }
  }
  @media (max-width: 860px) { .commission { grid-template-columns: 1fr; } .sgrid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .pgrid { grid-template-columns: repeat(2, 1fr); gap: 22px 14px; } .sgrid { gap: 22px 14px; } }
</style>
