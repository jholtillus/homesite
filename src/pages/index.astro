---
import Base from '../layouts/Base.astro';
import HeroCarousel from '../components/HeroCarousel.astro';
import FeaturedWork from '../components/FeaturedWork.astro';
import RecentWork from '../components/RecentWork.astro';
import Newsletter from '../components/Newsletter.astro';
import { projects } from '../data/site';
const featured = projects.filter((p) => p.featured);
---
<Base>
  <HeroCarousel />

  <section class="section wrap">
    <div class="section-head"><div><h2>Portfolio</h2><p class="sub">Some of my individual art pieces. I work mostly in watercolor and ink.</p></div><a href="/work/" class="link-arrow">All work</a></div>
    <FeaturedWork />
  </section>

  <section class="section">
    <div class="wrap section-head"><div><h2>Projects</h2><p class="sub">The major works I’ve produced.</p></div><a href="/projects/" class="link-arrow">All projects</a></div>
    <div class="wrap projects">
      {featured.map((p) => (
        <a href={`/projects/${p.slug}/`} class="proj reveal">
          <div class="img-frame"><img src={p.hero.src} alt={p.hero.alt} loading="lazy" width={p.hero.w} height={p.hero.h} /></div>
          <div class="pmeta"><p class="eyebrow">{p.kicker} · {p.status}</p><h3>{p.title}</h3><p class="muted">{p.summary}</p><span class="link-arrow">Explore</span></div>
        </a>
      ))}
    </div>
  </section>

  <section class="section wrap">
    <div class="section-head"><h2>Recent work</h2><a href="/projects/" class="link-arrow">All projects</a></div>
    <RecentWork />
  </section>

  <Newsletter />
</Base>

<style>
  .sub { font: italic 400 clamp(1.1rem, 1.6vw, 1.3rem)/1.4 var(--serif); color: var(--muted); margin: 10px 0 0; }
  .projects { display: grid; gap: clamp(48px, 7vw, 96px); }
  .proj { display: grid; grid-template-columns: 1.6fr 1fr; gap: clamp(24px, 4vw, 64px); align-items: end; }
  .proj:nth-child(even) { grid-template-columns: 1fr 1.6fr; }
  .proj:nth-child(even) .img-frame { order: 2; }
  .proj .img-frame { aspect-ratio: 2 / 1; }
  .pmeta h3 { font-size: clamp(2.2rem, 4vw, 3.4rem); margin: 14px 0 16px; }
  .pmeta .muted { max-width: 38ch; margin-bottom: 24px; }
  @media (max-width: 820px) {
    .proj, .proj:nth-child(even) { grid-template-columns: 1fr; }
    .proj:nth-child(even) .img-frame { order: 0; }
    .proj .img-frame { aspect-ratio: 3 / 2; }
  }
</style>
