---
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';
import Icon from '../components/Icon.astro';
import { site, social } from '../data/site';
---
<Base title="Commissions & Contact" description="Commission an illustration project, or get in touch about publishing, licensing and orders.">
  <div class="page contact">
    <div>
      <h1>Commissions</h1>
      <p class="lede">If you’re interested in having a project illustrated, you can start the conversation here.</p>
      <p>Commissioned work prices depend on scale, timeline, medium, and many more variables. Let’s discuss.</p>
      <p>I illustrate books, games, comics and graphic novels — primarily historical, mythological, religious and literary work — and work with publishers as well as private clients.</p>
      <dl>
        <div><dt>Orders</dt><dd>Questions about an order from Carthage Workshop? Choose “Order question”.</dd></div>
        {site.email && <div><dt>Email</dt><dd><a href={`mailto:${site.email}`} class="u">{site.email}</a></dd></div>}
        <div><dt>Elsewhere</dt><dd class="icons">{social.map((s) => <a href={s.href} target="_blank" rel="noopener" aria-label={s.label} title={s.label}><Icon name={s.key} /></a>)}</dd></div>
      </dl>
      <img class="art" src="/images/art/witch-of-hobomock-pass-cover.jpg" alt="The Witch of Hobomock Pass cover" width="1747" height="1390" loading="lazy" />
    </div>
    <div class="formcol"><ContactForm /></div>
  </div>
</Base>
<style>
  .contact { display: grid; grid-template-columns: 1fr 1.1fr; gap: clamp(28px, 6vw, 88px); align-items: start; }
  h1 { margin-bottom: 10px; }
  .contact p:not(.lede) { font-size: 14px; }
  dl { margin: 28px 0 0; border-top: 1px solid var(--line); }
  dl div { display: grid; grid-template-columns: 90px 1fr; gap: 16px; padding: 12px 0; border-bottom: 1px solid var(--line); font-size: 13.5px; }
  dt { color: var(--muted); } dd { margin: 0; }
  .icons { display: flex; gap: 16px; align-items: center; }
  .art { margin-top: 32px; }
  .formcol { background: var(--soft); padding: clamp(20px, 3vw, 36px); }
  .formcol :global(label:first-of-type) { margin-top: 0; }
  @media (max-width: 960px) { .contact { grid-template-columns: 1fr; } .art { display: none; } }
</style>
