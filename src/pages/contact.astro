---
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';
import { site, social } from '../data/site';
---
<Base title="Commissions" description="Commission an illustration project, or get in touch about publishing and orders.">
  <div class="page contact">
    <div class="info">
      <p class="eyebrow">Commissions</p>
      <h1>Let’s work together.</h1>
      <p class="lede muted">If you’re interested in having a project illustrated, you can start the conversation here.</p>
      <p>Commissioned work prices depend on scale, timeline, medium, and many more variables. Let’s discuss.</p>
      <p>I illustrate books, games, comics and graphic novels — mostly historical, mythological, religious and literary work — for publishers and private clients.</p>
      <ul class="links">
        {site.email && <li><span>Email</span><a href={`mailto:${site.email}`} class="u">{site.email}</a></li>}
        <li><span>Elsewhere</span><span>{social.slice(0, 3).map((s, i) => <>{i > 0 && ' · '}<a href={s.href} target="_blank" rel="noopener" class="u">{s.label}</a></>)}</span></li>
      </ul>
    </div>
    <ContactForm />
  </div>
</Base>
<style>
  .contact { display: grid; grid-template-columns: 1fr 1.15fr; gap: clamp(32px, 7vw, 112px); align-items: start; padding-bottom: 96px; }
  h1 { margin: 16px 0 20px; }
  .info p:not(.lede):not(.eyebrow) { font-size: 15px; max-width: 46ch; }
  .links { list-style: none; padding: 0; margin: 32px 0 0; border-top: 1px solid var(--line); }
  .links li { display: grid; grid-template-columns: 100px 1fr; gap: 16px; padding: 12px 0; border-bottom: 1px solid var(--line); font-size: 14px; }
  .links li > span:first-child { color: var(--muted); }
  @media (max-width: 900px) { .contact { grid-template-columns: 1fr; } }
</style>
