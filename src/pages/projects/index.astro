---
import Base from '../../layouts/Base.astro';
import { projects } from '../../data/site';
---
<Base title="Projects" description="Books and long-form projects: Theseus, Panomachea and more.">
  <section class="wrap head">
    <p class="eyebrow">Projects</p>
    <h1>Books &amp; long-form work</h1>
  </section>
  <section class="wrap list">
    {projects.map((p, i) => (
      <a href={`/projects/${p.slug}/`} class="row reveal">
        <span class="n">{String(i + 1).padStart(2, '0')}</span>
        <div class="img-frame"><img src={p.hero} alt={p.title} loading="lazy" width="2400" height="1200" /></div>
        <div><p class="eyebrow">{p.kicker} · {p.status}</p><h2>{p.title}</h2><p class="muted">{p.summary}</p><span class="link-arrow">Explore {p.title}</span></div>
      </a>
    ))}
  </section>
</Base>
<style>
  .head { padding: clamp(48px, 8vw, 112px) var(--gutter) clamp(32px, 5vw, 64px); }
  .head h1 { margin-top: 16px; }
  .list { padding-bottom: 120px; }
  .row { display: grid; grid-template-columns: 60px 1.4fr 1fr; gap: clamp(20px, 4vw, 56px); padding: 48px 0; border-top: 1px solid var(--line); align-items: center; }
  .n { font: 400 1rem var(--serif); color: var(--muted); align-self: start; }
  .row .img-frame { aspect-ratio: 2/1; }
  h2 { margin: 12px 0 14px; }
  .row .muted { margin-bottom: 22px; }
  @media (max-width: 820px) { .row { grid-template-columns: 1fr; } .n { display: none; } }
</style>
