---
// Projects: a carousel of every project; choosing one swaps in its case study below.
import Base from '../../layouts/Base.astro';
import { projects, caseStudyPlaceholders, caseStudyClosing, type Img } from '../../data/site';
import { getProducts } from '../../data/shopify';

const products = await getProducts();
const galleryImages = (p: (typeof projects)[number]) =>
  p.blocks.flatMap((b) => (b.kind === 'gallery' ? b.images : b.kind === 'image' ? [b.image] : [])) as Img[];
const studies = projects.map((p) => {
  const feature = p.caseStudy?.feature ?? p.hero;
  const pool = [...(p.caseStudy?.images ?? []), ...galleryImages(p).filter((i) => !/logo|the-art/.test(i.src)), p.cover, p.hero]
    .filter((im, k, all) => im.src !== feature.src && all.findIndex((x) => x.src === im.src) === k);
  const paras = p.caseStudy?.paras ?? caseStudyPlaceholders(p.title);
  return {
    p,
    rows: paras.map((t, k) => ({ text: t, img: pool[k % Math.max(pool.length, 1)] })),
    closing: p.caseStudy?.closing ?? caseStudyClosing(p.title),
    feature,
    caption: p.caseStudy?.featureCaption ?? p.title,
    shop: p.productTags.length > 0 && products.some((x) => x.tags.some((t) => p.productTags.includes(t))),
  };
});
---
<Base title="Projects" description="Graphic novels, card games and illustrated books by Jordan Holt.">
  <div class="page">
    <header class="head">
      <p class="eyebrow">Projects</p>
      <h1>The major works</h1>
      <p class="lede muted">Graphic novels, games and illustrated books — my own, and with other publishers. Choose a project to read its story.</p>
    </header>
  </div>

  <section class="wrap picker" data-picker>
    <div class="track" data-track role="tablist" aria-label="Projects">
      {projects.map((p, i) => (
        <button class="pick" role="tab" id={`tab-${p.slug}`} aria-controls={`cs-${p.slug}`} aria-selected={i === 0 ? 'true' : 'false'} data-slug={p.slug}>
          <span class="img-frame"><img src={p.cover.src} alt="" width={p.cover.w} height={p.cover.h} loading={i < 4 ? 'eager' : 'lazy'} /></span>
          <span class="eyebrow">{p.kicker}{p.status === 'Upcoming' ? ' · Upcoming' : ''}</span>
          <span class="t">{p.title}</span>
        </button>
      ))}
    </div>
    <div class="nav">
      <button data-prev aria-label="Previous project">←</button>
      <span class="count"><span data-num>01</span> / {String(projects.length).padStart(2, '0')}</span>
      <button data-next aria-label="Next project">→</button>
    </div>
  </section>

  <div class="studies" id="case-study">
    {studies.map(({ p, rows, closing, feature, caption, shop }, i) => (
      <article class="cs wrap" id={`cs-${p.slug}`} role="tabpanel" aria-labelledby={`tab-${p.slug}`} data-cs={p.slug} hidden={i !== 0}>
        <header class="cs-head">
          <div>
            <p class="eyebrow">{p.kicker}{p.partner ? ` · ${p.partner}` : ''} · {p.status}</p>
            <h2>{p.title}</h2>
            <p class="lede">{p.summary}</p>
          </div>
          <aside>
            <dl>{p.facts.map((f) => <div><dt>{f.label}</dt><dd>{f.value}</dd></div>)}</dl>
            <div class="acts">
              <a href={`/projects/${p.slug}/`} class="btn">Full project page</a>
              {shop && <a href={`/projects/${p.slug}/#shop`} class="btn solid">Buy</a>}
            </div>
          </aside>
        </header>

        <div class="rows">
          {rows.map((r, k) => (
            <section class:list={['row', { flip: k % 2 === 1 }]}>
              {r.img && <figure class="img-frame"><img src={r.img.src} alt={r.img.alt} width={r.img.w} height={r.img.h} loading="lazy" /></figure>}
              <div class="txt"><span class="eyebrow">{String(k + 1).padStart(2, '0')}</span><p class:list={{ ph: r.text.startsWith('PLACEHOLDER') }}>{r.text}</p></div>
            </section>
          ))}
        </div>

        <p class:list={['closing', { ph: closing.startsWith('PLACEHOLDER') }]}>{closing}</p>

        <figure class="cs-feature">
          <img src={feature.src} alt={feature.alt} width={feature.w} height={feature.h} loading="lazy" />
          <figcaption>{caption}</figcaption>
        </figure>
      </article>
    ))}
  </div>
</Base>

<style>
  .head { padding-bottom: clamp(28px, 4vw, 48px); }
  .head h1 { margin: 16px 0 20px; }
  .picker { --g: clamp(14px, 2vw, 24px); }
  .track { display: grid; grid-auto-flow: column; grid-auto-columns: calc((100% - 5 * var(--g)) / 6); gap: var(--g); overflow-x: auto; scroll-snap-type: x mandatory; scroll-behavior: smooth; scrollbar-width: none; padding-bottom: 4px; }
  .track::-webkit-scrollbar { display: none; }
  .pick { scroll-snap-align: start; text-align: left; display: flex; flex-direction: column; gap: 8px; opacity: .55; transition: opacity .3s; }
  .pick:hover, .pick[aria-selected='true'] { opacity: 1; }
  .pick .img-frame { aspect-ratio: 4 / 5; display: block; outline: 1px solid transparent; outline-offset: 4px; transition: outline-color .3s; }
  .pick[aria-selected='true'] .img-frame { outline-color: var(--fg); }
  .pick .eyebrow { margin-top: 6px; }
  .pick .t { font: 400 1.25rem/1.2 var(--serif); }
  .pick[aria-selected='true'] .t { font-style: italic; }
  .nav { display: flex; align-items: center; justify-content: flex-end; gap: 16px; margin-top: 20px; }
  .nav button { width: 44px; height: 44px; border: 1px solid var(--line); font-size: 16px; }
  .nav button:hover { border-color: var(--fg); }
  .count { font-size: 13px; color: var(--muted); font-variant-numeric: tabular-nums; }

  .studies { margin-top: clamp(40px, 6vw, 72px); border-top: 1px solid var(--line); scroll-margin-top: calc(var(--header) + 16px); }
  .cs { padding-top: clamp(40px, 6vw, 72px); animation: csin .6s var(--ease); }
  @keyframes csin { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
  .cs-head { display: grid; grid-template-columns: 1.5fr 1fr; gap: clamp(28px, 5vw, 80px); align-items: end; }
  .cs-head h2 { font-size: clamp(2.6rem, 5.5vw, 4.4rem); margin: 14px 0 18px; }
  .cs-head .lede { max-width: 40ch; margin: 0; }
  dl { margin: 0; border-top: 1px solid var(--line); }
  dl div { display: flex; justify-content: space-between; gap: 16px; padding: 12px 0; border-bottom: 1px solid var(--line); font-size: 14px; }
  dt { color: var(--muted); } dd { margin: 0; text-align: right; }
  .acts { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 20px; }
  .rows { display: grid; gap: clamp(48px, 7vw, 104px); margin-top: clamp(48px, 6vw, 88px); }
  .row { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(28px, 6vw, 96px); align-items: center; }
  .row figure { margin: 0; aspect-ratio: 4 / 5; }
  .row.flip figure { order: 2; }
  .txt { max-width: 46ch; }
  .txt .eyebrow { display: block; margin-bottom: 14px; }
  .txt p { font: 400 clamp(1.25rem, 1.9vw, 1.6rem)/1.5 var(--serif); margin: 0; }
  .ph { color: var(--muted); }
  .closing { margin: clamp(56px, 8vw, 112px) 0 0; padding-top: clamp(32px, 4vw, 48px); border-top: 1px solid var(--line); font: 400 clamp(1.4rem, 2.4vw, 2rem)/1.5 var(--serif); }
  .cs-feature { margin: clamp(48px, 6vw, 88px) 0 clamp(72px, 9vw, 120px); }
  .cs-feature img { width: 100%; max-height: 90vh; object-fit: cover; background: var(--soft); }
  .cs-feature figcaption { padding-top: 12px; font-size: 14px; color: var(--muted); }
  @media (max-width: 1000px) { .track { grid-auto-columns: calc((100% - 2 * var(--g)) / 3.3); } }
  @media (max-width: 820px) { .cs-head { grid-template-columns: 1fr; } .row { grid-template-columns: 1fr; } .row.flip figure { order: 0; } .row figure { aspect-ratio: 3 / 2; } }
  @media (max-width: 560px) { .track { grid-auto-columns: 42%; } }
  @media (prefers-reduced-motion: reduce) { .cs { animation: none; } }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-picker]')!;
  const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-slug]')];
  const panels = [...document.querySelectorAll<HTMLElement>('[data-cs]')];
  const studies = document.getElementById('case-study')!;
  const num = root.querySelector<HTMLElement>('[data-num]')!;
  let cur = 0;
  const select = (i: number, scroll = false) => {
    cur = (i + tabs.length) % tabs.length;
    tabs.forEach((t, k) => t.setAttribute('aria-selected', String(k === cur)));
    panels.forEach((p, k) => (p.hidden = k !== cur));
    num.textContent = String(cur + 1).padStart(2, '0');
    tabs[cur].scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'nearest' });
    try { history.replaceState(null, '', location.pathname + location.search + '#' + tabs[cur].dataset.slug); } catch {}
    if (scroll && studies.getBoundingClientRect().top > innerHeight * 0.6) studies.scrollIntoView({ behavior: 'smooth' });
  };
  tabs.forEach((t, k) => t.addEventListener('click', () => select(k, true)));
  root.querySelector('[data-prev]')!.addEventListener('click', () => select(cur - 1));
  root.querySelector('[data-next]')!.addEventListener('click', () => select(cur + 1));
  root.querySelector('[data-track]')!.addEventListener('keydown', (e) => {
    const k = (e as KeyboardEvent).key;
    if (k === 'ArrowRight' || k === 'ArrowLeft') { e.preventDefault(); select(cur + (k === 'ArrowRight' ? 1 : -1)); tabs[cur].focus(); }
  });
  const fromHash = () => { const i = tabs.findIndex((t) => '#' + t.dataset.slug === location.hash); if (i >= 0) select(i); };
  addEventListener('hashchange', fromHash); fromHash();
</script>
