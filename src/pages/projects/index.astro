---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projects, upcoming } from '../../data/site';
const current = projects.filter((p) => p.status !== 'Upcoming');
const next = projects.filter((p) => p.status === 'Upcoming');
---
<Base title="Projects" description="Graphic novels, card games and illustrated books by Jordan Holt.">
  <div class="page">
    <header class="head"><h1>Projects</h1><p class="lede">Graphic novels, games and illustrated books — my own, and with other publishers.</p></header>
    <div class="grid">{current.map((p) => <ProjectCard project={p} />)}</div>
    <section class="section">
      <div class="section-head"><h2>Upcoming</h2></div>
      <div class="up">
        <div class="grid">{next.map((p) => <ProjectCard project={p} />)}</div>
        <ul>{upcoming.map((u) => <li>{u}</li>)}</ul>
      </div>
    </section>
  </div>
</Base>
<style>
  .head { margin-bottom: 36px; } .head h1 { margin-bottom: 8px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 40px 24px; }
  .up { display: grid; grid-template-columns: minmax(220px, 300px) 1fr; gap: 40px; align-items: start; }
  .up .grid { grid-template-columns: 1fr; }
  ul { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--line); }
  li { padding: 12px 0; border-bottom: 1px solid var(--line); font-style: italic; }
  @media (max-width: 560px) { .grid { grid-template-columns: repeat(2, 1fr); gap: 28px 14px; } .up { grid-template-columns: 1fr; } .up .grid { grid-template-columns: repeat(2, 1fr); } }
</style>
