---
import Base from '../../layouts/Base.astro';
import Gallery from '../../components/Gallery.astro';
import ProductCard from '../../components/ProductCard.astro';
import Newsletter from '../../components/Newsletter.astro';
import { projects } from '../../data/site';
import { getProducts } from '../../data/shopify';

export function getStaticPaths() { return projects.map((p) => ({ params: { slug: p.slug }, props: { project: p } })); }
const { project: p } = Astro.props;
const related = p.productTags.length ? (await getProducts()).filter((x) => x.tags.some((t) => p.productTags.includes(t))) : [];
const i = projects.indexOf(p), next = projects[(i + 1) % projects.length];
---
<Base title={p.title} description={p.summary} image={p.hero.src}>
  <section class:list={['hero', { dark: p.heroDark }]}>
    <img src={p.hero.src} alt={p.hero.alt} width={p.hero.w} height={p.hero.h} fetchpriority="high" />
    <div class="hero-txt">
      <p class="eyebrow">{p.kicker}{p.partner ? ` · ${p.partner}` : ''}</p>
      <h1>{p.title}</h1>
    </div>
  </section>

  <div class="page">
    <section class="intro">
      <p class="summary">{p.summary}</p>
      <aside>
        <dl>{p.facts.map((f) => <div><dt>{f.label}</dt><dd>{f.value}</dd></div>)}</dl>
        <div class="actions">
          {related.length > 0 && <a href="#shop" class="btn solid">Shop {p.title}</a>}
          {p.links.map((l) => <a href={l.href} target="_blank" rel="noopener" class="btn">{l.label} ↗</a>)}
        </div>
      </aside>
    </section>

    <div class="blocks">
      {p.blocks.map((b) => (
        b.kind === 'text' ? (
          <section class="b-text">{b.heading && <h2>{b.heading}</h2>}{b.paras.map((t) => <p>{t}</p>)}</section>
        ) : b.kind === 'image' ? (
          <figure class:list={['b-image', { wide: b.wide }]}>
            <img src={b.image.src} alt={b.image.alt} width={b.image.w} height={b.image.h} loading="lazy" decoding="async" />
            {b.caption && <figcaption>{b.caption}</figcaption>}
          </figure>
        ) : b.kind === 'gallery' ? (
          <div class="b-gallery"><Gallery items={b.images} row={320} /></div>
        ) : (
          <section class="b-text"><h2>{b.heading}</h2><ul>{b.items.map((x) => <li>{x}</li>)}</ul></section>
        )
      ))}
    </div>

    {related.length > 0 && (
      <section class="section" id="shop">
        <div class="section-head"><h2>Shop {p.title}</h2><a href="/shop/" class="link">Visit the shop</a></div>
        <div class="sgrid">{related.map((x) => <ProductCard product={x} />)}</div>
      </section>
    )}

    {p.status === 'Upcoming' && <Newsletter heading={`Follow ${p.title}`} text={`Get an email when ${p.title} launches.`} />}

    <a href={`/projects/${next.slug}/`} class="next">
      <span class="eyebrow">Next project</span>
      <span class="t">{next.title} →</span>
    </a>
  </div>
</Base>
<style>
  .hero { position: relative; height: min(64vh, 640px); min-height: 320px; overflow: hidden; background: #111; }
  .hero img { width: 100%; height: 100%; object-fit: cover; object-position: center 30%; }
  .hero-txt { position: absolute; left: 0; right: 0; bottom: 0; padding: 80px var(--pad) clamp(24px, 4vw, 44px); background: linear-gradient(transparent, rgba(0,0,0,.6)); color: #fff; }
  .hero:not(.dark) .hero-txt { background: linear-gradient(transparent, rgba(0,0,0,.45)); }
  .hero-txt .eyebrow { color: rgba(255,255,255,.85); margin-bottom: 8px; }
  .hero-txt h1 { font-size: clamp(2.2rem, 5vw, 3.8rem); text-shadow: 0 2px 20px rgba(0,0,0,.3); }
  .intro { display: grid; grid-template-columns: 1.4fr 1fr; gap: clamp(28px, 5vw, 80px); padding: clamp(16px, 2vw, 24px) 0 clamp(40px, 5vw, 64px); }
  .summary { font-size: clamp(1.1rem, 1.7vw, 1.4rem); line-height: 1.65; font-style: italic; margin: 0; }
  dl { margin: 0; border-top: 1px solid var(--line); }
  dl div { display: flex; justify-content: space-between; gap: 16px; padding: 10px 0; border-bottom: 1px solid var(--line); font-size: 13px; }
  dt { color: var(--muted); } dd { margin: 0; text-align: right; }
  .actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 20px; }
  .blocks { display: flex; flex-direction: column; gap: clamp(32px, 4.5vw, 56px); }
  .b-text { max-width: 68ch; margin: 0 auto; width: 100%; }
  .b-text h2 { margin-bottom: 16px; }
  .b-text p { font-size: 15px; }
  .b-image { margin: 0 auto; max-width: 820px; width: 100%; }
  .b-image.wide { max-width: none; }
  .b-image figcaption { font-size: 12.5px; color: var(--muted); font-style: italic; margin-top: 8px; }
  .sgrid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 32px 22px; }
  .next { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; flex-wrap: wrap; margin-top: clamp(56px, 8vw, 96px); padding-top: 28px; border-top: 1px solid var(--line); }
  .next .t { font-size: clamp(1.5rem, 3vw, 2.2rem); font-style: italic; }
  .next:hover .t { text-decoration: underline; text-underline-offset: 5px; text-decoration-thickness: 1px; }
  @media (max-width: 860px) { .intro { grid-template-columns: 1fr; } }
  @media (max-width: 560px) { .sgrid { grid-template-columns: repeat(2, 1fr); gap: 24px 14px; } .hero { height: 52vh; } }
</style>
