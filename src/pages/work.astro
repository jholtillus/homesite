---
import Base from '../layouts/Base.astro';
import Gallery from '../components/Gallery.astro';
import { artwork } from '../data/site';
---
<Base title="Work" description="Illustration for books, games, comics and graphic novels: historical, mythological, religious and literary work.">
  <div class="page">
    <header class="head">
      <h1>Work</h1>
      <p class="lede">Historical, mythological, religious and literary work — books, games, comics & graphic novels.</p>
    </header>
    <Gallery items={artwork} filters row={280} />
    <hr class="rule" />
    <div class="cta"><h2>Have a project in mind?</h2><a href="/contact/" class="btn solid">Start a commission</a></div>
  </div>
</Base>
<style>
  .head { margin-bottom: 28px; } .head h1 { margin-bottom: 8px; }
  .cta { display: flex; justify-content: space-between; align-items: center; gap: 20px; flex-wrap: wrap; }
</style>
