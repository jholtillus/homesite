---
import Base from '../layouts/Base.astro';
---
<Base title="Not found">
  <section class="wrap" style="padding:clamp(80px,14vw,200px) var(--gutter)">
    <p class="eyebrow">404</p>
    <h1 style="margin:16px 0 24px">Lost in the labyrinth.</h1>
    <p class="lede muted" style="margin-bottom:36px">The page you’re looking for has moved or doesn’t exist.</p>
    <a href="/" class="btn solid">Return home</a>
  </section>
</Base>
