---
// News: three live columns (YouTube, X, Substack). Videos play in place, Substack posts
// can be read in full in place, and X posts come from X's official timeline embed.
// A source filter switches between all three columns and one source at full width.
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { site, studioNews } from '../data/site';
import { getVideos, getPosts, getTweets } from '../data/feeds';
import { videoCard, postCard, tweetCard, fmtDate } from '../scripts/feed-render';

const videos = await getVideos();
const posts = await getPosts();
const tweets = await getTweets();
const cols = [
  { key: 'youtube', label: 'YouTube', sub: 'Process videos', href: `https://youtube.com/@${site.youtubeHandle}`, cta: 'Subscribe' },
  { key: 'x', label: 'X', sub: `@${site.twitterHandle}`, href: `https://x.com/${site.twitterHandle}`, cta: 'Follow' },
  { key: 'substack', label: 'Substack', sub: 'Newsletter of Illustration & Myth', href: 'https://jholtillus.substack.com/', cta: 'Subscribe' },
];
---
<Base title="News" description="Videos, posts and newsletter writing from Jordan Holt, in one place.">
  <div class="page">
    <header class="head">
      <p class="eyebrow">News</p>
      <h1>From the studio</h1>
      <p class="lede muted">Videos, posts and the newsletter in one place. Watch and read here, then follow the link for more.</p>
    </header>

    {studioNews.length > 0 && (
      <section class="pinned" aria-label="Announcements">
        {studioNews.map((n) => (
          <a href={n.href} class="pin">
            {n.image && <span class="img-frame"><img src={n.image} alt="" loading="lazy" /></span>}
            <span><span class="eyebrow">{n.date ? fmtDate(n.date) : 'New'} · {n.source}</span><span class="t">{n.title}</span><span class="s muted">{n.summary}</span></span>
          </a>
        ))}
      </section>
    )}

    <div class="filter" role="tablist" aria-label="Choose a source" data-filter>
      <button role="tab" aria-selected="true" data-view="all">All</button>
      {cols.map((c) => <button role="tab" aria-selected="false" data-view={c.key}><Icon name={c.key} size={15} />{c.label}</button>)}
    </div>

    <section class="feed" data-feed data-view="all">
      {cols.map((c) => (
        <div class="col" data-col={c.key}>
          <header class="ch">
            <Icon name={c.key} size={20} />
            <span><b>{c.label}</b><span class="muted">{c.sub}</span></span>
            <a href={c.href} target="_blank" rel="noopener" class="btn sm">{c.cta}</a>
          </header>
          <div class="list" data-list={c.key}>
            {c.key === 'youtube' && (videos.length ? <Fragment set:html={videos.map(videoCard).join('')} /> : <p class="empty muted">New videos appear here. <a class="u" href={c.href} target="_blank" rel="noopener">Visit the channel ↗</a></p>)}
            {c.key === 'substack' && (posts.length ? <Fragment set:html={posts.map(postCard).join('')} /> : <p class="empty muted">New posts appear here. <a class="u" href={c.href} target="_blank" rel="noopener">Read on Substack ↗</a></p>)}
            {c.key === 'x' && (
              <>
                <div class="x-embed" data-x-embed>
                  <a class="twitter-timeline" data-chrome="noheader nofooter noborders transparent" data-dnt="true" href={`https://twitter.com/${site.twitterHandle}`}>Posts by @{site.twitterHandle}</a>
                </div>
                {tweets.length > 0 && <div class="x-fallback" data-x-fallback set:html={tweets.map((t) => tweetCard(t, site.twitterHandle)).join('')} />}
              </>
            )}
          </div>
          <button class="seeall" data-see={c.key}>See all {c.label} →</button>
        </div>
      ))}
    </section>
  </div>
</Base>

<style>
  .head { margin-bottom: clamp(28px, 4vw, 44px); }
  .head h1 { margin: 16px 0 20px; }
  .pinned { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 16px; margin-bottom: clamp(32px, 4vw, 48px); }
  .pin { display: grid; grid-template-columns: 96px 1fr; gap: 18px; align-items: center; padding: 14px; background: var(--soft); }
  .pin .img-frame { aspect-ratio: 1; }
  .pin > span:last-child { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .pin .t { font: 400 1.3rem/1.2 var(--serif); }
  .pin .s { font-size: 13px; }
  .pin:hover .t { font-style: italic; }

  .filter { display: flex; gap: 8px; flex-wrap: wrap; padding-bottom: 20px; border-bottom: 1px solid var(--line); margin-bottom: 28px; }
  .filter button { display: inline-flex; align-items: center; gap: 8px; min-height: 38px; padding: 0 16px; border: 1px solid var(--line); border-radius: 19px; font: 400 12px/1 var(--sans); letter-spacing: .06em; text-transform: uppercase; color: var(--muted); transition: all .2s; }
  .filter button:hover { color: var(--fg); border-color: var(--fg); }
  .filter button[aria-selected='true'] { background: var(--fg); border-color: var(--fg); color: #fff; }

  .feed { margin-bottom: clamp(72px, 9vw, 120px); display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(16px, 2.4vw, 32px); align-items: start; }
  .col { min-width: 0; display: flex; flex-direction: column; }
  .ch { display: grid; grid-template-columns: auto 1fr auto; gap: 12px; align-items: center; padding-bottom: 14px; margin-bottom: 4px; border-bottom: 1px solid var(--fg); }
  .ch > span { display: flex; flex-direction: column; line-height: 1.3; min-width: 0; }
  .ch b { font: 400 1.35rem/1.2 var(--serif); }
  .ch .muted { font-size: 12px; }
  .btn.sm { min-height: 32px; padding: 0 12px; font-size: 10.5px; }
  .list { max-height: 1100px; overflow-y: auto; scrollbar-width: thin; padding-right: 4px; }
  .seeall { display: none; margin-top: 16px; font: 400 12px/1 var(--sans); letter-spacing: .08em; text-transform: uppercase; padding: 14px 0; border-top: 1px solid var(--line); text-align: left; }
  .empty { padding: 20px 0; font-size: 14px; }

  /* Single-source view: one source across the full width */
  .feed:not([data-view='all']) { grid-template-columns: 1fr; }
  .feed:not([data-view='all']) .col:not(.on) { display: none; }
  .feed:not([data-view='all']) .list { max-height: none; overflow: visible; display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 0 clamp(16px, 2.4vw, 32px); }
  .feed:not([data-view='all']) .list > .x-embed, .feed:not([data-view='all']) .list > .x-fallback { grid-column: 1 / -1; max-width: 640px; }

  /* Cards */
  .list :global(.fi) { padding: 20px 0; border-bottom: 1px solid var(--line); }
  .list :global(.fi h3) { font-size: 1.3rem; line-height: 1.25; margin: 4px 0 8px; }
  .list :global(time) { font-size: 12px; color: var(--muted); letter-spacing: .03em; }
  .list :global(.out) { display: inline-block; margin-top: 8px; font-size: 12.5px; border-bottom: 1px solid currentColor; }
  .list :global(.out:hover) { color: var(--muted); }
  .list :global(.sample) { display: inline-block; margin-right: 8px; padding: 2px 7px; border: 1px dashed var(--muted); font-size: 10px; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); vertical-align: 1px; }
  .list :global(.play) { position: relative; display: block; width: 100%; aspect-ratio: 16 / 9; background: #111; overflow: hidden; margin-bottom: 12px; }
  .list :global(.play img) { width: 100%; height: 100%; object-fit: cover; opacity: .9; transition: opacity .3s, transform .6s var(--ease); }
  .list :global(.play:hover img) { opacity: 1; transform: scale(1.02); }
  .list :global(.pb) { position: absolute; left: 50%; top: 50%; width: 58px; height: 58px; margin: -29px 0 0 -29px; border-radius: 50%; background: rgba(255,255,255,.92); }
  .list :global(.pb::after) { content: ''; position: absolute; left: 23px; top: 18px; border-left: 17px solid #111; border-top: 11px solid transparent; border-bottom: 11px solid transparent; }
  .list :global(.play[disabled]) { cursor: default; }
  .list :global(.yt iframe) { width: 100%; aspect-ratio: 16 / 9; border: 0; display: block; margin-bottom: 12px; }
  .list :global(.cover) { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; margin-bottom: 12px; background: var(--soft); }
  .list :global(.ex) { font-size: 14px; color: var(--muted); margin: 0; }
  .list :global(details) { margin-top: 10px; }
  .list :global(summary) { cursor: pointer; list-style: none; font: 400 11px/1 var(--sans); letter-spacing: .1em; text-transform: uppercase; display: inline-flex; padding: 9px 14px; border: 1px solid var(--fg); }
  .list :global(summary::-webkit-details-marker) { display: none; }
  .list :global(summary:hover) { background: var(--fg); color: #fff; }
  .list :global(details .less), .list :global(details[open] .more) { display: none; }
  .list :global(details[open] .less) { display: inline; }
  .list :global(.post) { margin-top: 16px; padding: 16px 0 4px; border-top: 1px solid var(--line); font-size: 15px; line-height: 1.75; }
  .list :global(.post img) { margin: 12px 0; }
  .list :global(.post a) { text-decoration: underline; }
  .list :global(.tw p) { font-size: 15px; line-height: 1.6; margin: 10px 0; }
  .list :global(.who) { display: flex; align-items: center; gap: 10px; font-size: 13px; }
  .list :global(.who .h) { color: var(--muted); }
  .list :global(.who .sample) { margin-left: auto; }
  .list :global(.av) { display: grid; place-items: center; width: 36px; height: 36px; border-radius: 50%; background: var(--fg); color: #fff; font: 400 13px/1 var(--serif); }
  .list :global(.tm) { display: flex; justify-content: space-between; align-items: baseline; }
  .x-embed :global(a.twitter-timeline) { display: block; padding: 20px 0; font-size: 14px; color: var(--muted); }

  @media (max-width: 960px) {
    .feed[data-view='all'] { grid-template-columns: 1fr; gap: 48px; }
    .feed[data-view='all'] .list { max-height: none; overflow: visible; }
    .feed[data-view='all'] .list > :global(.fi:nth-child(n+4)) { display: none; }
    .feed[data-view='all'] .x-fallback :global(.fi:nth-child(n+4)) { display: none; }
    .feed[data-view='all'] .seeall { display: block; }
  }
  @media (max-width: 520px) { .pin { grid-template-columns: 72px 1fr; } }
</style>

<script>
  import { videoCard, postCard } from '../scripts/feed-render';
  const feed = document.querySelector<HTMLElement>('[data-feed]')!;
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-view]')].filter((b) => b.tagName === 'BUTTON');
  const view = (v: string) => {
    feed.dataset.view = v;
    tabs.forEach((t) => t.setAttribute('aria-selected', String(t.dataset.view === v)));
    feed.querySelectorAll<HTMLElement>('[data-col]').forEach((c) => c.classList.toggle('on', c.dataset.col === v));
    if (v === 'x' || v === 'all') loadX();
  };
  tabs.forEach((t) => t.addEventListener('click', () => view(t.dataset.view!)));
  feed.querySelectorAll<HTMLButtonElement>('[data-see]').forEach((b) => b.addEventListener('click', () => { view(b.dataset.see!); document.querySelector('[data-filter]')!.scrollIntoView({ behavior: 'smooth' }); }));

  // Play YouTube videos in place.
  feed.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-yt]'); if (!b) return;
    const f = document.createElement('iframe');
    f.src = `https://www.youtube-nocookie.com/embed/${b.dataset.yt}?autoplay=1&rel=0`;
    f.title = b.getAttribute('aria-label') ?? 'Video'; f.allow = 'autoplay; encrypted-media; picture-in-picture'; f.allowFullscreen = true;
    b.replaceWith(f);
  });

  // X timeline: load X's widget script once; keep the fallback until it renders.
  let xLoaded = false;
  function loadX() {
    if (xLoaded) return; xLoaded = true;
    const s = document.createElement('script'); s.src = 'https://platform.twitter.com/widgets.js'; s.async = true;
    s.onload = () => (window as any).twttr?.events?.bind('rendered', () => document.querySelector<HTMLElement>('[data-x-fallback]')?.remove());
    document.body.append(s);
  }
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((es) => { if (es.some((x) => x.isIntersecting)) { loadX(); io.disconnect(); } });
    io.observe(document.querySelector('[data-x-embed]')!);
  }

  // Live refresh from the /feeds Lambda when the API is configured.
  const api = import.meta.env.PUBLIC_API_URL;
  if (api) fetch(`${api}/feeds`).then((r) => (r.ok ? r.json() : null)).then((d) => {
    if (!d) return;
    if (d.videos?.length) feed.querySelector('[data-list="youtube"]')!.innerHTML = d.videos.map(videoCard).join('');
    if (d.posts?.length) feed.querySelector('[data-list="substack"]')!.innerHTML = d.posts.map(postCard).join('');
  }).catch(() => {});
</script>
