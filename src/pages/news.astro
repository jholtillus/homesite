---
import Base from '../layouts/Base.astro';
import NewsList from '../components/NewsList.astro';
import Icon from '../components/Icon.astro';
import { site, social } from '../data/site';
import { getNews, getYouTube } from '../data/feeds';
const items = await getNews(30);
const latest = (await getYouTube(1))[0];
const latestId = latest?.href.split('v=')[1];
---
<Base title="News" description="Studio news, new releases, Substack posts and YouTube videos from Jordan Holt.">
  <div class="page">
    <header class="head">
      <h1>News</h1>
      <p class="lede">New releases, process videos and the Newsletter of Illustration and Myth.</p>
      <div class="follow">
        {social.map((s) => <a href={s.href} target="_blank" rel="noopener" class="btn"><Icon name={s.key} size={16} />{s.label}</a>)}
        <a href="/rss.xml" class="btn">RSS</a>
      </div>
    </header>

    <section class="cols">
      <div>
        <div class="section-head"><h2>Latest</h2></div>
        <NewsList items={items} />
        <p class="note muted">Substack posts and YouTube videos appear here automatically on each site rebuild.</p>
      </div>
      <aside>
        <div class="card">
          <p class="eyebrow">YouTube</p>
          {latestId
            ? <div class="v"><iframe src={`https://www.youtube-nocookie.com/embed/${latestId}`} title={latest!.title} loading="lazy" allow="encrypted-media; picture-in-picture" allowfullscreen></iframe></div>
            : <a href={`https://youtube.com/@${site.youtubeHandle}`} target="_blank" rel="noopener" class="v ph"><Icon name="youtube" size={44} /></a>}
          <h3>{latest?.title ?? 'Process videos & studio updates'}</h3>
          <a href={`https://youtube.com/@${site.youtubeHandle}`} target="_blank" rel="noopener" class="link">Subscribe @{site.youtubeHandle}</a>
        </div>
        <div class="card">
          <p class="eyebrow">Substack</p>
          <h3>J. Holt’s Newsletter of Illustration and Myth</h3>
          <p class="muted">Long-form posts on the making of the books and games.</p>
          <a href="https://jholtillus.substack.com/" target="_blank" rel="noopener" class="link">Read on Substack</a>
        </div>
        <div class="card">
          <p class="eyebrow">X</p>
          <h3>@{site.twitterHandle}</h3>
          <p class="muted">Sketches, works in progress and announcements.</p>
          <a href={`https://x.com/${site.twitterHandle}`} target="_blank" rel="noopener" class="link">Follow on X</a>
        </div>
      </aside>
    </section>
  </div>
</Base>
<style>
  .head { margin-bottom: 40px; } .head h1 { margin-bottom: 8px; }
  .follow { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 20px; }
  .follow .btn { min-height: 38px; padding: 0 14px; font-size: 12.5px; }
  .cols { display: grid; grid-template-columns: 1.7fr 1fr; gap: clamp(28px, 5vw, 72px); }
  .cols > * { min-width: 0; }
  .note { font-size: 12.5px; font-style: italic; margin-top: 14px; }
  aside { display: flex; flex-direction: column; gap: 20px; }
  .card { background: var(--soft); padding: 24px; }
  .card h3 { margin: 8px 0 8px; font-size: 1.05rem; }
  .card .muted { font-size: 13px; }
  .v { display: block; aspect-ratio: 16/9; margin-top: 12px; background: #111; }
  .v iframe { width: 100%; height: 100%; border: 0; }
  .v.ph { display: grid; place-items: center; color: #fff; }
  @media (max-width: 960px) { .cols { grid-template-columns: 1fr; } }
</style>
