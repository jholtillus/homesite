---
import Base from '../layouts/Base.astro';
import NewsList from '../components/NewsList.astro';
import Newsletter from '../components/Newsletter.astro';
import { studioNews, site, social } from '../data/site';
import { getYouTube } from '../data/youtube';
const videos = await getYouTube(site.youtubeChannelId, 6);
const items = [...videos, ...studioNews].sort((a, b) => b.date.localeCompare(a.date));
const latestId = videos[0]?.href.split('v=')[1];
---
<Base title="News" description="Studio updates, new releases, YouTube videos and posts.">
  <section class="wrap head">
    <p class="eyebrow">News &amp; updates</p>
    <h1>From the studio</h1>
    <div class="subs">
      {social.map((s) => <a href={s.href} target="_blank" rel="noopener" class="btn">{s.label}</a>)}
      <a href="/rss.xml" class="btn">RSS</a>
    </div>
  </section>

  <section class="wrap video">
    <div class="vframe">
      {latestId
        ? <iframe src={`https://www.youtube-nocookie.com/embed/${latestId}`} title="Latest video" loading="lazy" allow="accelerometer; encrypted-media; picture-in-picture" allowfullscreen></iframe>
        : <div class="vph"><p class="eyebrow">YouTube</p><p class="lede">Latest video appears here once PUBLIC_YOUTUBE_CHANNEL_ID is set.</p></div>}
    </div>
    <div class="vside">
      <p class="eyebrow">Latest on YouTube</p>
      <h2>{videos[0]?.title ?? 'Process & studio videos'}</h2>
      <a href={social.find((s) => s.key === 'youtube')!.href} target="_blank" rel="noopener" class="link-arrow">Subscribe on YouTube</a>
    </div>
  </section>

  <section class="section wrap cols">
    <div><NewsList items={items} /></div>
    <aside class="x">
      <p class="eyebrow">On X</p>
      {site.twitterHandle
        ? <a class="twitter-timeline" data-height="640" data-chrome="noheader nofooter noborders transparent" href={`https://twitter.com/${site.twitterHandle}`}>Posts by @{site.twitterHandle}</a>
        : <p class="muted" style="margin-top:16px">Timeline appears here once PUBLIC_TWITTER_HANDLE is set.</p>}
      {site.twitterHandle && <script async src="https://platform.twitter.com/widgets.js" charset="utf-8"></script>}
    </aside>
  </section>
  <Newsletter heading="Never miss a launch." />
</Base>
<style>
  .head { padding-top: clamp(48px, 8vw, 112px); padding-bottom: clamp(32px, 5vw, 56px); }
  .head h1 { margin: 16px 0 28px; }
  .subs { display: flex; flex-wrap: wrap; gap: 10px; }
  .video { display: grid; grid-template-columns: 2fr 1fr; gap: clamp(24px, 4vw, 64px); align-items: end; padding-bottom: 96px; }
  .vframe { aspect-ratio: 16/9; background: var(--soft); }
  .vframe iframe { width: 100%; height: 100%; border: 0; }
  .vph { height: 100%; display: flex; flex-direction: column; justify-content: center; padding: 40px; gap: 12px; }
  .vside h2 { margin: 14px 0 24px; }
  .cols { display: grid; grid-template-columns: 2fr 1fr; gap: clamp(32px, 6vw, 96px); }
  .video > *, .cols > * { min-width: 0; }
  .x { border-top: 1px solid var(--line); padding-top: 22px; }
  @media (max-width: 900px) { .video, .cols { grid-template-columns: 1fr; } }
</style>
