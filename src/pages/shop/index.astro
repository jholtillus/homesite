---
import Base from '../../layouts/Base.astro';
import ProductCard from '../../components/ProductCard.astro';
import { getProducts } from '../../data/shopify';
const products = await getProducts();
const order = ['Book', 'Game', 'Original', 'Print', 'Digital'] as const;
const label: Record<string, string> = { All: 'All', Book: 'Books', Game: 'Games', Original: 'Originals', Print: 'Prints', Digital: 'Digital' };
const types = ['All', ...order.filter((t) => products.some((p) => p.type === t))];
const sorted = [...products].sort((a, b) => order.indexOf(a.type) - order.indexOf(b.type));
---
<Base title="Shop" description="Original artwork, signed prints, graphic novels and card games by Jordan Holt — Carthage Workshop.">
  <div class="page">
    <header class="head">
      <div><p class="eyebrow">Carthage Workshop</p><h1>Works of Myth, Fable & History</h1></div>
      <p class="muted">Original artwork, signed prints, graphic novels and games. Free domestic shipping. Secure checkout through Shopify at carthageworkshop.com.</p>
    </header>
    <div class="filters" role="tablist" aria-label="Filter products">
      {types.map((t, i) => <button role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-f={t}>{label[t]} <span>{t === 'All' ? products.length : products.filter((p) => p.type === t).length}</span></button>)}
    </div>
    <div class="grid" data-products>{sorted.map((p) => <ProductCard product={p} />)}</div>
  </div>
</Base>
<style>
  .head { display: grid; grid-template-columns: 1.2fr 1fr; gap: 16px 48px; align-items: end; margin-bottom: 32px; }
  .head h1 { margin-top: 8px; }
  .head p.muted { font-size: 14px; margin: 0; }
  .filters { display: flex; gap: 24px; border-bottom: 1px solid var(--line); margin-bottom: 32px; overflow-x: auto; scrollbar-width: none; }
  .filters button { font-size: 13.5px; color: var(--muted); padding: 10px 0; border-bottom: 1px solid transparent; margin-bottom: -1px; white-space: nowrap; }
  .filters button span { font-size: 10px; vertical-align: super; }
  .filters button[aria-selected='true'] { color: var(--fg); border-color: var(--fg); font-style: italic; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 44px 24px; }
  @media (max-width: 860px) { .head { grid-template-columns: 1fr; } }
  @media (max-width: 560px) { .grid { grid-template-columns: repeat(2, 1fr); gap: 32px 14px; } }
</style>
<script>
  const cards = [...document.querySelectorAll<HTMLElement>('[data-products] .pc')];
  document.querySelectorAll<HTMLButtonElement>('[data-f]').forEach((b, _, all) => b.addEventListener('click', () => {
    all.forEach((x) => x.setAttribute('aria-selected', String(x === b)));
    cards.forEach((c) => (c.hidden = b.dataset.f !== 'All' && c.dataset.type !== b.dataset.f));
  }));
</script>
