---
import Base from '../../layouts/Base.astro';
import ProductCard from '../../components/ProductCard.astro';
import { getProducts, formatPrice } from '../../data/shopify';
import { site, projects } from '../../data/site';

export async function getStaticPaths() {
  const all = await getProducts();
  return all.map((p) => ({ params: { handle: p.handle }, props: { product: p, all } }));
}
const { product: p, all } = Astro.props;
const related = all.filter((x) => x.handle !== p.handle && (x.type === p.type || x.tags.some((t) => p.tags.includes(t)))).slice(0, 4);
const project = projects.find((pr) => pr.productTags.some((t) => p.tags.includes(t)));
const firstAvail = p.variants.find((v) => v.available) ?? p.variants[0];
const showVariants = p.variants.length > 1;
const paras = p.description.split('\n').filter(Boolean);
const payload = { handle: p.handle, title: p.title, image: p.image, currency: p.currency, variants: p.variants };
---
<Base title={p.title} description={p.description.slice(0, 155)} image={p.image}>
  <div class="page">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/shop/">Shop</a><span>/</span><span>{p.type}</span></nav>
    <section class="pdp">
      <div class="media">
        <div class="main frame"><img src={p.images[0] ?? p.image} alt={p.title} data-main width="1200" height="1200" /></div>
        {p.images.length > 1 && (
          <div class="thumbs">
            {p.images.map((src, i) => <button data-thumb={src} aria-label={`Show image ${i + 1}`} aria-current={i === 0 ? 'true' : 'false'} class="frame"><img src={src} alt="" loading="lazy" width="200" height="200" /></button>)}
          </div>
        )}
      </div>
      <div class="info">
        <p class="eyebrow">{p.type}{p.type === 'Original' ? ' · One of a kind' : ''}</p>
        <h1>{p.title}</h1>
        <p class="price" data-price>{p.available ? formatPrice(firstAvail.price, p.currency) : 'Sold'}</p>
        {showVariants && (
          <fieldset class="variants">
            <legend class="sr-only">Option</legend>
            {p.variants.map((v) => (
              <label class:list={['opt', { off: !v.available }]}>
                <input type="radio" name="variant" value={v.id} checked={v.id === firstAvail.id} disabled={!v.available} />
                <span>{v.title}{!v.available && ' — sold out'}</span>
              </label>
            ))}
          </fieldset>
        )}
        <button class="btn solid block add" data-add disabled={!p.available}>{p.available ? 'Add to cart' : 'Sold'}</button>
        <div class="desc">{paras.map((t) => <p>{t}</p>)}</div>
        <ul class="assure">
          <li>Secure checkout through Shopify at {site.shopDomain}</li>
          {project && <li>Part of <a href={`/projects/${project.slug}/`} class="u">{project.title}</a></li>}
          <li>Questions? <a href="/contact/" class="u">Get in touch</a></li>
        </ul>
      </div>
    </section>
    {related.length > 0 && (
      <section class="section">
        <div class="section-head"><h2>You may also like</h2><a href="/shop/" class="link">All products</a></div>
        <div class="rel">{related.map((r) => <ProductCard product={r} />)}</div>
      </section>
    )}
  </div>
  <script type="application/json" id="product-data" set:html={JSON.stringify(payload)} />
</Base>
<style>
  .crumbs { display: flex; gap: 8px; font-size: 12.5px; color: var(--muted); margin-bottom: 20px; }
  .crumbs a:hover { color: var(--fg); }
  .pdp { display: grid; grid-template-columns: 1.25fr 1fr; gap: clamp(28px, 5vw, 72px); align-items: start; }
  .main { aspect-ratio: 1; background: var(--soft); }
  .main img { object-fit: contain; }
  .thumbs { display: grid; grid-template-columns: repeat(auto-fill, minmax(72px, 1fr)); gap: 8px; margin-top: 8px; }
  .thumbs button { aspect-ratio: 1; opacity: .6; transition: opacity .2s; }
  .thumbs button[aria-current='true'], .thumbs button:hover { opacity: 1; }
  .info { position: sticky; top: 32px; }
  h1 { font-size: clamp(1.6rem, 2.6vw, 2.2rem); margin: 8px 0 10px; }
  .price { font-size: 1.05rem; margin-bottom: 18px; }
  .variants { border: 0; padding: 0; margin: 0 0 18px; display: flex; flex-wrap: wrap; gap: 8px; }
  .opt { position: relative; margin: 0; text-transform: none; letter-spacing: 0; color: var(--fg); font-size: 13px; }
  .opt input { position: absolute; inset: 0; opacity: 0; margin: 0; width: 100%; height: 100%; }
  .opt span { display: inline-block; padding: 9px 16px; border: 1px solid #cfcac3; border-radius: 3px; cursor: pointer; }
  .opt input:checked + span { border-color: #111; background: #111; color: #fff; }
  .opt input:focus-visible + span { outline: 1px solid #111; outline-offset: 2px; }
  .opt.off span { opacity: .4; text-decoration: line-through; cursor: not-allowed; }
  .desc { margin-top: 28px; padding-top: 22px; border-top: 1px solid var(--line); font-size: 14px; }
  .desc p { margin-bottom: .6em; }
  .assure { list-style: none; padding: 0; margin: 20px 0 0; font-size: 12.5px; color: var(--muted); display: grid; gap: 6px; }
  .rel { display: grid; grid-template-columns: repeat(4, 1fr); gap: 22px; }
  @media (max-width: 1099px) { .info { top: calc(var(--header) + 20px); } }
  @media (max-width: 860px) { .pdp { grid-template-columns: 1fr; } .info { position: static; } .rel { grid-template-columns: repeat(2, 1fr); gap: 28px 14px; } }
</style>
<script>
  import { cart, money } from '../../scripts/cart';
  const data = JSON.parse(document.getElementById('product-data')!.textContent!);
  const priceEl = document.querySelector<HTMLElement>('[data-price]')!;
  const current = () => { const id = document.querySelector<HTMLInputElement>('input[name=variant]:checked')?.value; return data.variants.find((v: any) => v.id === id) ?? data.variants.find((v: any) => v.available) ?? data.variants[0]; };
  document.querySelectorAll<HTMLInputElement>('input[name=variant]').forEach((r) => r.addEventListener('change', () => (priceEl.textContent = money(current().price, data.currency))));
  const main = document.querySelector<HTMLImageElement>('[data-main]')!;
  document.querySelectorAll<HTMLButtonElement>('[data-thumb]').forEach((b, _, all) => b.addEventListener('click', () => { main.src = b.dataset.thumb!; all.forEach((x) => x.setAttribute('aria-current', String(x === b))); }));
  const btn = document.querySelector<HTMLButtonElement>('[data-add]')!;
  btn.addEventListener('click', () => {
    const v = current();
    cart.add({ variantId: v.id, title: data.title, variantTitle: v.title, price: v.price, currency: data.currency, image: data.image, handle: data.handle });
    btn.textContent = 'Added'; setTimeout(() => (btn.textContent = 'Add to cart'), 1600);
    document.dispatchEvent(new CustomEvent('cart:open'));
  });
</script>
