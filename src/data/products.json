  {
    "handle": "panomachea-battle-with-gods-heroes-monsters",
    "title": "Panomachea - Battle with Gods, Heroes & Monsters",
    "type": "Game",
    "price": "18.00",
    "currency": "USD",
    "image": "/images/products/panomachea-battle-with-gods-heroes-monsters-1.jpg",
